---
interface Props {
  lang?: 'zh' | 'en';
  currentPath?: string;
  alternateUrl?: string;
}

const { lang = 'zh', currentPath = '/', alternateUrl } = Astro.props;

const isZh = lang === 'zh';

const navItems = isZh
  ? [
      { name: '🧪 生活实验', href: '/category/life-labs' },
      { name: '⚡ 日常工作流', href: '/category/workflows' },
      { name: '🧠 习惯进化', href: '/category/habit-shifts' },
      { name: '🧰 实用工具箱', href: '/category/my-stack' },
      { name: '关于', href: '/about' },
    ]
  : [
      { name: '🧪 Life Labs', href: '/en/category/life-labs' },
      { name: '⚡ Workflows', href: '/en/category/workflows' },
      { name: '🧠 Habit Shifts', href: '/en/category/habit-shifts' },
      { name: '🧰 My Stack', href: '/en/category/my-stack' },
      { name: 'About', href: '/en/about' },
    ];

// Determine alternate link for language toggle
const toggleUrl = alternateUrl 
  ? alternateUrl 
  : (isZh ? '/en' : '/');
---

<header class="border-b border-[#E6E0D6] bg-[#FAF7F2]/90 backdrop-blur-md sticky top-0 z-50 transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between">
    <!-- Brand Logo & Title -->
    <a href={isZh ? '/' : '/en'} class="flex items-center gap-3.5 group">
      <img 
        src="/images/logo.jpeg" 
        alt="Everyday AI Lab Logo" 
        class="w-11 h-11 rounded-xl border-2 border-[#181715] shadow-[0_2px_0_#181715] group-hover:rotate-3 group-hover:scale-105 transition-all duration-200 object-cover"
      />
      <div>
        <div class="flex items-baseline gap-2">
          <span class="font-serif font-extrabold text-2xl tracking-tight text-[#181715]">日常AI</span>
          <span class="font-serif italic text-sm text-[#E05A2B] font-bold hidden sm:inline">Everyday AI Lab</span>
        </div>
        <p class="text-xs text-[#57524A] font-mono tracking-tight hidden md:block">
          {isZh ? '只聊生活中的 AI，记录普通人的日常实践' : 'Practical experiments for everyday humans'}
        </p>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-6">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class="text-sm font-semibold text-[#181715] hover:text-[#E05A2B] transition-colors py-1.5 border-b-2 border-transparent hover:border-[#E05A2B]"
        >
          {item.name}
        </a>
      ))}
    </nav>

    <!-- Language Switcher & Subscribe Button -->
    <div class="flex items-center gap-3">
      <a 
        href={toggleUrl}
        class="clay-chip text-xs px-3.5 py-1.5 border-2 border-[#181715] text-[#181715] hover:bg-[#181715] hover:text-[#FAF7F2] transition-colors flex items-center gap-1.5 font-bold"
        title={isZh ? 'Switch to English' : '切换为中文'}
      >
        <span>🌐</span>
        <span>{isZh ? 'EN' : '中文'}</span>
      </a>

      <a 
        href="#subscribe" 
        class="btn-tactile bg-[#1E5E3A] hover:bg-[#15452A] text-[#FAF7F2] text-xs font-bold px-4 py-2 rounded-xl hidden sm:inline-flex"
      >
        {isZh ? '订阅周报' : 'Subscribe'}
      </a>
    </div>
  </div>

  <!-- Mobile Subnav -->
  <div class="lg:hidden border-t border-[#E6E0D6] bg-[#FAF7F2] px-4 py-2.5 overflow-x-auto flex gap-4 text-xs font-medium no-scrollbar">
    {navItems.map((item) => (
      <a href={item.href} class="whitespace-nowrap font-medium text-[#181715] hover:text-[#E05A2B]">
        {item.name}
      </a>
    ))}
  </div>
</header>
