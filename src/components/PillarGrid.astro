---
interface Props {
  lang?: 'zh' | 'en';
}

const { lang = 'zh' } = Astro.props;
const isZh = lang === 'zh';

const pillars = isZh
  ? [
      {
        id: 'life-labs',
        tag: 'LAB 01',
        title: '生活实验',
        enTitle: 'Life Labs',
        desc: '衣食住行、家庭管理、育儿、健康与理财的真实 AI 改造实录。',
        href: '/category/life-labs',
        image: '/images/pillar-1-life-labs.jpeg',
        color: '#D97757',
      },
      {
        id: 'workflows',
        tag: 'LAB 02',
        title: '日常工作流',
        enTitle: 'Workflows',
        desc: '普通人零代码提效、跨界学习一门新技能的完整闭环拆解。',
        href: '/category/workflows',
        image: '/images/pillar-2-workflows.jpeg',
        color: '#2C5E43',
      },
      {
        id: 'habit-shifts',
        tag: 'LAB 03',
        title: '习惯进化',
        enTitle: 'Habit Shifts',
        desc: '记录人类从“搜索答案”到“学会提问”、从“死记硬背”到“审美把关”的思维转变。',
        href: '/category/habit-shifts',
        image: '/images/pillar-3-habit-shifts.jpeg',
        color: '#2C5E43',
      },
      {
        id: 'my-stack',
        tag: 'LAB 04',
        title: '实用工具箱',
        enTitle: 'My Stack',
        desc: '整理亲测留存的日常 AI 工具与高频提示词模板。',
        href: '/category/my-stack',
        image: '/images/pillar-4-my-stack.jpeg',
        color: '#D97757',
      },
    ]
  : [
      {
        id: 'life-labs',
        tag: 'LAB 01',
        title: 'Life Labs',
        enTitle: '生活实验',
        desc: 'Real-life AI makeovers for daily living, cooking, family, health, and parenting.',
        href: '/en/category/life-labs',
        image: '/images/pillar-1-life-labs.jpeg',
        color: '#D97757',
      },
      {
        id: 'workflows',
        tag: 'LAB 02',
        title: 'Workflows',
        enTitle: '日常工作流',
        desc: 'Zero-code practical productivity and end-to-end skill acquisition loops.',
        href: '/en/category/workflows',
        image: '/images/pillar-2-workflows.jpeg',
        color: '#2C5E43',
      },
      {
        id: 'habit-shifts',
        tag: 'LAB 03',
        title: 'Habit Shifts',
        enTitle: '习惯进化',
        desc: 'Unlearning keyword searching, mastering inquiry, and shifting from memorization to curation.',
        href: '/en/category/habit-shifts',
        image: '/images/pillar-3-habit-shifts.jpeg',
        color: '#2C5E43',
      },
      {
        id: 'my-stack',
        tag: 'LAB 04',
        title: 'My Stack',
        enTitle: '实用工具箱',
        desc: 'Battle-tested daily AI apps, workflows, and reusable prompt blueprints.',
        href: '/en/category/my-stack',
        image: '/images/pillar-4-my-stack.jpeg',
        color: '#D97757',
      },
    ];
---

<section class="my-14">
  <div class="flex items-baseline justify-between mb-8">
    <div>
      <h2 class="text-xl sm:text-2xl font-black text-[#1E1E1E] tracking-tight">
        {isZh ? '四大固定栏目' : 'Four Pillar Labs'}
      </h2>
      <p class="text-xs sm:text-sm text-[#5C5852] mt-1">
        {isZh ? '用严谨的实验精神，解构具体的日常琐碎' : 'Deconstructing everyday friction with a lab mindset'}
      </p>
    </div>
    <span class="text-xs font-mono text-[#D97757] font-semibold">
      SYSTEM ARCHITECTURE
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {pillars.map((item) => (
      <a 
        href={item.href}
        class="group bg-[#FAF8F5] border-2 border-[#1E1E1E] rounded-2xl overflow-hidden hover:shadow-[6px_6px_0px_#1E1E1E] transition-all duration-200 flex flex-col sm:flex-row relative"
      >
        <!-- Card Cover / Thumbnail -->
        <div class="sm:w-44 h-40 sm:h-auto overflow-hidden bg-[#E8E2D8] border-b-2 sm:border-b-0 sm:border-r-2 border-[#1E1E1E] shrink-0">
          <img 
            src={item.image} 
            alt={item.title}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            loading="lazy"
          />
        </div>

        <!-- Content -->
        <div class="p-6 flex flex-col justify-between flex-1">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-[#D97757] tracking-wider">
                {item.tag}
              </span>
              <span class="text-xs text-[#2C5E43] font-mono group-hover:translate-x-1 transition-transform">
                Explore →
              </span>
            </div>
            
            <h3 class="text-lg font-bold text-[#1E1E1E] group-hover:text-[#D97757] transition-colors flex items-baseline gap-2">
              <span>{item.title}</span>
              <span class="text-xs font-serif italic text-[#5C5852] font-normal">{item.enTitle}</span>
            </h3>

            <p class="text-xs sm:text-sm text-[#5C5852] mt-2 leading-relaxed">
              {item.desc}
            </p>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
