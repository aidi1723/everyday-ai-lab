---
interface Props {
  title: string;
  url: string;
  lang?: 'zh' | 'en';
  variant?: 'card' | 'compact';
}

const { title, url, lang = 'zh', variant = 'card' } = Astro.props;
const isZh = lang === 'zh';

const twitterShareUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(
  title + ' | Everyday AI Lab\n'
)}&url=${encodeURIComponent(url)}&via=edailab&hashtags=EverydayAI,AI`;

const whatsAppShareUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(
  title + ' - ' + url
)}`;
---

{variant === 'compact' ? (
  <!-- Compact Bar (Top of article) -->
  <div class="social-share-compact my-5 flex flex-wrap items-center justify-between gap-2.5 py-2.5 px-3.5 bg-[#F4EFEA] border border-[#D9D3C7] rounded-xl text-xs font-mono" role="region" aria-label={isZh ? '文章快捷分享' : 'Article quick share'}>
    <div class="flex items-center gap-1.5 text-[#5C5852]">
      <span>📤</span>
      <span class="font-bold text-[#1E1E1E]">{isZh ? '分享这篇实验：' : 'Share dispatch:'}</span>
    </div>

    <div class="flex items-center gap-2 flex-wrap">
      <!-- Native Mobile Share Button (Shown only when navigator.share is supported) -->
      <button
        type="button"
        class="native-share-btn hidden inline-flex items-center gap-1 px-2.5 py-1 bg-[#FAF8F5] hover:bg-[#EFECE6] text-[#1E1E1E] rounded-md border border-[#1E1E1E] transition-colors cursor-pointer text-[11px] font-bold"
        data-title={title}
        data-url={url}
        aria-label={isZh ? '唤起系统分享菜单' : 'Trigger system share'}
        title={isZh ? '系统多端分享' : 'System Share'}
      >
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
        </svg>
        <span>{isZh ? '系统分享' : 'Share'}</span>
      </button>

      <!-- Share to X -->
      <a
        href={twitterShareUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 px-2.5 py-1 bg-[#1E1E1E] hover:bg-[#333333] text-[#FAF8F5] rounded-md transition-colors text-[11px] font-bold"
        aria-label={isZh ? '分享到 X (Twitter)' : 'Share to X (Twitter)'}
        title="Share to X"
      >
        <svg class="w-2.5 h-2.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
        <span>X</span>
      </a>

      <!-- Share to WhatsApp -->
      <a
        href={whatsAppShareUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 px-2.5 py-1 bg-[#25D366] hover:bg-[#1EBE5D] text-white rounded-md transition-colors text-[11px] font-bold"
        aria-label={isZh ? '分享到 WhatsApp' : 'Share to WhatsApp'}
        title="Share to WhatsApp"
      >
        <svg class="w-2.5 h-2.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.187-2.59-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.299.144.35.491 1.199.534 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564c.173.087.289.13.332.203.043.072.043.419-.101.824z"/>
        </svg>
        <span>WhatsApp</span>
      </a>

      <!-- Copy Link Button -->
      <button
        type="button"
        class="copy-article-link-btn inline-flex items-center gap-1 px-2.5 py-1 bg-[#FAF8F5] hover:bg-[#EFECE6] text-[#1E1E1E] rounded-md transition-colors border border-[#1E1E1E] cursor-pointer text-[11px] font-bold"
        data-url={url}
        data-copied={isZh ? '已复制！' : 'Copied!'}
        data-default={isZh ? '复制链接' : 'Copy'}
        aria-label={isZh ? '复制文章直达链接' : 'Copy article direct link'}
      >
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
        </svg>
        <span class="share-copy-label">{isZh ? '复制链接' : 'Copy'}</span>
      </button>
    </div>
  </div>
) : (
  <!-- Card Mode (Bottom of article) -->
  <div class="social-share my-8 p-5 sm:p-6 bg-[#FAF8F5] border-2 border-[#1E1E1E] rounded-2xl shadow-[4px_4px_0px_#1E1E1E]" role="region" aria-label={isZh ? '文章社交分享卡片' : 'Article social share card'}>
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <h4 class="font-bold text-sm sm:text-base text-[#1E1E1E] flex items-center gap-1.5">
          <span>💌</span>
          <span>{isZh ? '觉得有启发？随手分享给身边的朋友' : 'Found this useful? Share it with a friend'}</span>
        </h4>
        <p class="text-xs text-[#5C5852] mt-1">
          {isZh ? '不聊虚假参数，只聊普通人的真实生活 AI 实践。' : 'No corporate hype. Just human-centric AI experiments.'}
        </p>
      </div>

      <div class="flex items-center gap-2.5 flex-wrap">
        <!-- Native Mobile Share Button (Shown only when navigator.share is supported) -->
        <button
          type="button"
          class="native-share-btn hidden inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#FAF8F5] hover:bg-[#EFECE6] text-[#1E1E1E] text-xs font-mono font-bold rounded-lg transition-colors border border-[#1E1E1E] cursor-pointer"
          data-title={title}
          data-url={url}
          aria-label={isZh ? '唤起系统分享菜单' : 'Trigger system share'}
          title={isZh ? '系统多端分享' : 'System Share'}
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
          </svg>
          <span>{isZh ? '系统分享' : 'Share'}</span>
        </button>

        <!-- Share to X -->
        <a
          href={twitterShareUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#1E1E1E] hover:bg-[#333333] text-[#FAF8F5] text-xs font-mono font-bold rounded-lg transition-colors border border-[#1E1E1E]"
          aria-label={isZh ? '分享到 X (Twitter)' : 'Share to X (Twitter)'}
          title="Share to X"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
          <span>X (Twitter)</span>
        </a>

        <!-- Share to WhatsApp -->
        <a
          href={whatsAppShareUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#25D366] hover:bg-[#1EBE5D] text-white text-xs font-mono font-bold rounded-lg transition-colors border border-[#1E1E1E]"
          aria-label={isZh ? '分享到 WhatsApp' : 'Share to WhatsApp'}
          title="Share to WhatsApp"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.187-2.59-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.299.144.35.491 1.199.534 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564c.173.087.289.13.332.203.043.072.043.419-.101.824z"/>
          </svg>
          <span>WhatsApp</span>
        </a>

        <!-- Copy Link Button -->
        <button
          type="button"
          class="copy-article-link-btn inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#FAF8F5] hover:bg-[#EFECE6] text-[#1E1E1E] text-xs font-mono font-bold rounded-lg transition-colors border border-[#1E1E1E] cursor-pointer"
          data-url={url}
          data-copied={isZh ? '已复制！' : 'Copied!'}
          data-default={isZh ? '复制链接' : 'Copy'}
          aria-label={isZh ? '复制文章直达链接' : 'Copy article direct link'}
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
          </svg>
          <span class="share-copy-label">{isZh ? '复制链接' : 'Copy'}</span>
        </button>
      </div>
    </div>
  </div>
)}

<script>
  function setupSocialSharing() {
    // Reveal native share buttons only if navigator.share is actually supported
    if (typeof navigator !== 'undefined' && navigator.share) {
      document.querySelectorAll('.native-share-btn').forEach((btn) => {
        btn.classList.remove('hidden');
      });
    }

    // 1. Copy Link handler
    document.querySelectorAll('.copy-article-link-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const url = btn.getAttribute('data-url');
        const copied = btn.getAttribute('data-copied') || 'Copied!';
        const def = btn.getAttribute('data-default') || 'Copy';
        const label = btn.querySelector('.share-copy-label');
        if (!url) return;

        try {
          await navigator.clipboard.writeText(url);
          if (label) label.textContent = copied;
          setTimeout(() => {
            if (label) label.textContent = def;
          }, 2000);
        } catch (e) {
          const ta = document.createElement('textarea');
          ta.value = url;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
          if (label) label.textContent = copied;
          setTimeout(() => {
            if (label) label.textContent = def;
          }, 2000);
        }
      });
    });

    // 2. Native Web Share API handler
    document.querySelectorAll('.native-share-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const title = btn.getAttribute('data-title') || document.title;
        const url = btn.getAttribute('data-url') || window.location.href;

        if (navigator.share) {
          try {
            await navigator.share({
              title: title,
              text: `${title} | Everyday AI Lab`,
              url: url,
            });
          } catch (err) {}
        }
      });
    });
  }

  setupSocialSharing();
  document.addEventListener('astro:page-load', setupSocialSharing);
</script>
