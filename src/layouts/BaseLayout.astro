---
import '@fontsource-variable/fraunces';
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/plus-jakarta-sans/800.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '@fontsource/jetbrains-mono/700.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'zh' | 'en';
  image?: string;
  alternateUrl?: string;
  pubDate?: Date;
  author?: string;
  type?: 'website' | 'article';
  categoryName?: string;
  categorySlug?: string;
  tags?: string[];
}

const {
  title = '日常AI | Everyday AI Lab',
  description = '只聊生活中的 AI，记录普通人的日常实践。Only about AI in real life.',
  lang = 'zh',
  image = '/images/hero-banner.webp',
  alternateUrl,
  pubDate,
  author = 'Everyday AI Lab',
  type = 'website',
  categoryName,
  categorySlug,
  tags,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullImageURL = new URL(image, Astro.site);

const jsonLd = type === 'article' ? {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${canonicalURL.toString()}#article`,
      headline: title,
      description: description,
      image: fullImageURL.toString(),
      datePublished: pubDate ? pubDate.toISOString() : undefined,
      dateModified: pubDate ? pubDate.toISOString() : undefined,
      inLanguage: lang === 'zh' ? 'zh-CN' : 'en-US',
      articleSection: categoryName,
      keywords: tags && tags.length > 0 ? tags.join(', ') : undefined,
      author: {
        '@type': 'Person',
        name: author,
        url: 'https://0500005.xyz/about',
      },
      publisher: {
        '@type': 'Organization',
        name: 'Everyday AI Lab',
        url: 'https://0500005.xyz/',
        logo: {
          '@type': 'ImageObject',
          url: new URL('/images/logo.jpeg', Astro.site).toString(),
        },
        sameAs: [
          'https://x.com/edailab',
          'https://www.youtube.com/@edai_lab',
          'https://chill-first.vercel.app',
        ],
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalURL.toString(),
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalURL.toString()}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: lang === 'zh' ? '首页' : 'Home',
          item: lang === 'zh' ? 'https://0500005.xyz/' : 'https://0500005.xyz/en/',
        },
        ...(categoryName && categorySlug ? [
          {
            '@type': 'ListItem',
            position: 2,
            name: categoryName,
            item: lang === 'zh'
              ? `https://0500005.xyz/category/${categorySlug}/`
              : `https://0500005.xyz/en/category/${categorySlug}/`,
          },
          {
            '@type': 'ListItem',
            position: 3,
            name: title,
            item: canonicalURL.toString(),
          },
        ] : [
          {
            '@type': 'ListItem',
            position: 2,
            name: title,
            item: canonicalURL.toString(),
          },
        ]),
      ],
    },
  ],
} : {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://0500005.xyz/#website',
      url: 'https://0500005.xyz/',
      name: '日常AI | Everyday AI Lab',
      alternateName: ['日常AI', 'Everyday AI Lab', '日常AI生活实验室'],
      description: description,
      inLanguage: ['zh-CN', 'en-US'],
      publisher: {
        '@id': 'https://0500005.xyz/#organization',
      },
    },
    {
      '@type': 'Organization',
      '@id': 'https://0500005.xyz/#organization',
      name: 'Everyday AI Lab',
      alternateName: '日常AI',
      url: 'https://0500005.xyz/',
      logo: {
        '@type': 'ImageObject',
        url: new URL('/images/logo.jpeg', Astro.site).toString(),
      },
      sameAs: [
        'https://x.com/edailab',
        'https://www.youtube.com/@edai_lab',
        'https://chill-first.vercel.app',
      ],
    },
  ],
};
---

<!DOCTYPE html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/images/logo.jpeg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Bidirectional hreflang Language Alternates -->
    {lang === 'zh' ? (
      <>
        <link rel="alternate" hreflang="zh-CN" href={canonicalURL} />
        {alternateUrl && <link rel="alternate" hreflang="en" href={new URL(alternateUrl, Astro.site)} />}
        <link rel="alternate" hreflang="x-default" href={canonicalURL} />
      </>
    ) : (
      <>
        <link rel="alternate" hreflang="en" href={canonicalURL} />
        {alternateUrl && <link rel="alternate" hreflang="zh-CN" href={new URL(alternateUrl, Astro.site)} />}
        {alternateUrl && <link rel="alternate" hreflang="x-default" href={new URL(alternateUrl, Astro.site)} />}
      </>
    )}

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageURL} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'zh' ? 'en_US' : 'zh_CN'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@edailab" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageURL} />

    <!-- RSS Feeds (Bilingual) -->
    <link rel="alternate" type="application/rss+xml" title="日常AI | Everyday AI Lab (中文)" href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Everyday AI Lab (English)" href="/en/rss.xml" />

    <!-- AI & LLM Discovery Feeds (GEO / Answer Engine Optimization) -->
    <link rel="alternate" type="text/plain" title="LLM Index" href="/llms.txt" />
    <link rel="alternate" type="text/plain" title="LLM Full Corpus" href="/llms-full.txt" />
    <link rel="alternate" type="application/json" title="Machine Brand Facts" href="/brand-facts.json" />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen flex flex-col text-[#181715] selection:bg-[#E05A2B] selection:text-[#FAF7F2]">
    <!-- Top Reading Scroll Progress Bar -->
    <div id="reading-progress" class="fixed top-0 left-0 h-[3px] bg-gradient-to-r from-[#E05A2B] via-[#F59E0B] to-[#1E5E3A] z-[60] transition-all duration-75 pointer-events-none shadow-[0_1px_8px_rgba(224,90,43,0.4)]" style="width: 0%"></div>

    <Header lang={lang} currentPath={Astro.url.pathname} alternateUrl={alternateUrl} />
    
    <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 py-8">
      <slot />
    </main>

    <Footer lang={lang} />

    <!-- Tactile Claymorphic Floating Back to Top Button -->
    <button
      id="back-to-top"
      type="button"
      class="fixed bottom-6 right-6 z-40 p-3.5 bg-[#FAF7F2] border-2 border-[#181715] rounded-full shadow-[0_4px_0_#181715,0_6px_14px_rgba(24,23,21,0.08)] hover:shadow-[0_2px_0_#181715] hover:translate-y-0.5 active:translate-y-1.5 active:shadow-[0_0_0_#181715] transition-all duration-200 cursor-pointer opacity-0 pointer-events-none group"
      aria-label="回到顶部 / Back to top"
      title="回到顶部"
    >
      <svg class="w-4 h-4 text-[#181715] group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
      </svg>
    </button>

    <script>
      function setupReadingUtilities() {
        const bar = document.getElementById('reading-progress');
        const btt = document.getElementById('back-to-top');
        const article = document.querySelector('article');

        const updateScroll = () => {
          const scrollTop = window.scrollY || document.documentElement.scrollTop;

          if (bar) {
            if (article) {
              const rect = article.getBoundingClientRect();
              const articleTop = rect.top + scrollTop;
              const articleHeight = rect.height;
              const winHeight = window.innerHeight;
              const scrollWithinArticle = scrollTop - articleTop;
              const maxArticleScroll = articleHeight - winHeight;

              if (maxArticleScroll > 0) {
                const progress = Math.min(100, Math.max(0, (scrollWithinArticle / maxArticleScroll) * 100));
                bar.style.width = `${progress}%`;
              } else {
                bar.style.width = '100%';
              }
            } else {
              const docHeight = document.documentElement.scrollHeight - window.innerHeight;
              const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
              bar.style.width = `${progress}%`;
            }
          }

          if (btt) {
            if (scrollTop > 400) {
              btt.classList.remove('opacity-0', 'pointer-events-none');
              btt.classList.add('opacity-100');
            } else {
              btt.classList.add('opacity-0', 'pointer-events-none');
              btt.classList.remove('opacity-100');
            }
          }
        };

        window.addEventListener('scroll', updateScroll, { passive: true });
        updateScroll();

        if (btt) {
          btt.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }
      }

      function setup3DCardPhysics() {
        // Only run on desktop devices with hover & fine pointer, and respect reduced motion
        if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const cards = document.querySelectorAll('.card-3d, .interactive-tilt');
        cards.forEach((card) => {
          const el = card as HTMLElement;
          if (el.dataset.tiltInit === 'true') return;
          el.dataset.tiltInit = 'true';

          let bounds: DOMRect | null = null;
          let ticking = false;

          const onMouseEnter = () => {
            bounds = el.getBoundingClientRect();
            el.style.transition = 'transform 0.12s ease-out, box-shadow 0.25s ease-out';
          };

          const onMouseMove = (e: MouseEvent) => {
            if (!bounds) bounds = el.getBoundingClientRect();
            const mouseX = e.clientX - bounds.left;
            const mouseY = e.clientY - bounds.top;

            if (!ticking) {
              requestAnimationFrame(() => {
                if (!bounds) return;
                const centerX = bounds.width / 2;
                const centerY = bounds.height / 2;
                const percentX = (mouseX - centerX) / centerX;
                const percentY = (mouseY - centerY) / centerY;

                // Subtle organic tilt angle
                const maxRotation = 4;
                const rotX = -percentY * maxRotation;
                const rotY = percentX * maxRotation;

                el.style.transform = `perspective(1000px) rotateX(${rotX.toFixed(2)}deg) rotateY(${rotY.toFixed(2)}deg) scale3d(1.012, 1.012, 1.012)`;
                el.style.setProperty('--sheen-x', `${mouseX.toFixed(0)}px`);
                el.style.setProperty('--sheen-y', `${mouseY.toFixed(0)}px`);
                el.style.setProperty('--sheen-opacity', '1');
                ticking = false;
              });
              ticking = true;
            }
          };

          const onMouseLeave = () => {
            bounds = null;
            el.style.transition = 'transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.45s cubic-bezier(0.16, 1, 0.3, 1)';
            el.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
            el.style.setProperty('--sheen-opacity', '0');
          };

          el.addEventListener('mouseenter', onMouseEnter);
          el.addEventListener('mousemove', onMouseMove);
          el.addEventListener('mouseleave', onMouseLeave);
        });
      }

      function initAll() {
        setupReadingUtilities();
        setup3DCardPhysics();
      }

      initAll();
      document.addEventListener('astro:page-load', initAll);
    </script>
  </body>
</html>
