---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'zh' | 'en';
  image?: string;
  alternateUrl?: string;
  pubDate?: Date;
  author?: string;
  type?: 'website' | 'article';
}

const {
  title = '日常AI | Everyday AI Lab',
  description = '只聊生活中的 AI，记录普通人的日常实践。Only about AI in real life.',
  lang = 'zh',
  image = '/images/hero-banner.png',
  alternateUrl,
  pubDate,
  author = 'Everyday AI Lab',
  type = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullImageURL = new URL(image, Astro.site);

const jsonLd = type === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  image: fullImageURL.toString(),
  datePublished: pubDate ? pubDate.toISOString() : undefined,
  author: {
    '@type': 'Person',
    name: author,
    url: 'https://0500005.xyz/about',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Everyday AI Lab',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/images/logo.jpeg', Astro.site).toString(),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL.toString(),
  },
} : {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '日常AI | Everyday AI Lab',
  url: 'https://0500005.xyz',
  description: description,
  publisher: {
    '@type': 'Organization',
    name: 'Everyday AI Lab',
    logo: new URL('/images/logo.jpeg', Astro.site).toString(),
  },
};
---

<!DOCTYPE html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/images/logo.jpeg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@edailab" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageURL} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="日常AI | Everyday AI Lab RSS Feed" href="/rss.xml" />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen flex flex-col text-[#1E1E1E]">
    <!-- Top Reading Scroll Progress Bar -->
    <div id="reading-progress" class="fixed top-0 left-0 h-[3px] bg-gradient-to-r from-[#D97757] via-[#F4A261] to-[#2C5E43] z-50 transition-all duration-75 pointer-events-none" style="width: 0%"></div>

    <Header lang={lang} currentPath={Astro.url.pathname} alternateUrl={alternateUrl} />
    
    <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 py-8">
      <slot />
    </main>

    <Footer lang={lang} />

    <!-- Tactile Floating Back to Top Button -->
    <button
      id="back-to-top"
      type="button"
      class="fixed bottom-6 right-6 z-40 p-3 bg-[#FAF8F5] border-2 border-[#1E1E1E] rounded-full shadow-[4px_4px_0px_#1E1E1E] hover:shadow-[2px_2px_0px_#1E1E1E] hover:translate-x-0.5 hover:translate-y-0.5 active:translate-x-1 active:translate-y-1 transition-all duration-200 cursor-pointer opacity-0 pointer-events-none"
      aria-label="回到顶部 / Back to top"
      title="回到顶部"
    >
      <svg class="w-4 h-4 text-[#1E1E1E]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
      </svg>
    </button>

    <script>
      function setupReadingUtilities() {
        const bar = document.getElementById('reading-progress');
        const btt = document.getElementById('back-to-top');

        window.addEventListener('scroll', () => {
          const scrollTop = window.scrollY || document.documentElement.scrollTop;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
          if (bar) bar.style.width = `${progress}%`;

          if (btt) {
            if (scrollTop > 400) {
              btt.classList.remove('opacity-0', 'pointer-events-none');
              btt.classList.add('opacity-100');
            } else {
              btt.classList.add('opacity-0', 'pointer-events-none');
              btt.classList.remove('opacity-100');
            }
          }
        }, { passive: true });

        if (btt) {
          btt.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }
      }

      setupReadingUtilities();
      document.addEventListener('astro:page-load', setupReadingUtilities);
    </script>
  </body>
</html>
