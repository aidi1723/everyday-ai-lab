---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'zh' | 'en';
  image?: string;
  alternateUrl?: string;
  pubDate?: Date;
  author?: string;
  type?: 'website' | 'article';
}

const {
  title = '日常AI | Everyday AI Lab',
  description = '只聊生活中的 AI，记录普通人的日常实践。Only about AI in real life.',
  lang = 'zh',
  image = '/images/hero-banner.png',
  alternateUrl,
  pubDate,
  author = 'Everyday AI Lab',
  type = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullImageURL = new URL(image, Astro.site);

const jsonLd = type === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  image: fullImageURL.toString(),
  datePublished: pubDate ? pubDate.toISOString() : undefined,
  author: {
    '@type': 'Person',
    name: author,
    url: 'https://0500005.xyz/about',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Everyday AI Lab',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/images/logo.jpeg', Astro.site).toString(),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL.toString(),
  },
} : {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '日常AI | Everyday AI Lab',
  url: 'https://0500005.xyz',
  description: description,
  publisher: {
    '@type': 'Organization',
    name: 'Everyday AI Lab',
    logo: new URL('/images/logo.jpeg', Astro.site).toString(),
  },
};
---

<!DOCTYPE html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/images/logo.jpeg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@edailab" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageURL} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="日常AI | Everyday AI Lab RSS Feed" href="/rss.xml" />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen flex flex-col bg-[#FAF8F5] text-[#1E1E1E]">
    <Header lang={lang} currentPath={Astro.url.pathname} alternateUrl={alternateUrl} />
    
    <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 py-8">
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>
