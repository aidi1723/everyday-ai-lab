---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 - 页面走丢了 | 日常AI"
  description="抱歉，你要找的页面不存在。欢迎返回《日常AI》生活实验室主页。"
  lang="zh"
>
  <div class="max-w-2xl mx-auto py-16 text-center">
    <div class="inline-flex items-center gap-2 bg-[#E05A2B] text-[#FAF7F2] text-xs font-mono font-bold px-3.5 py-1.5 rounded-full mb-6 shadow-2xs">
      <span>ERROR 404</span>
    </div>

    <h1 class="font-serif text-6xl sm:text-7xl font-black text-[#181715] tracking-tight mb-4">
      404
    </h1>

    <h2 class="font-serif text-2xl sm:text-3xl font-extrabold text-[#181715] mb-4">
      哎呀，这个生活实验好像跑丢了
    </h2>

    <p class="font-sans text-base text-[#57524A] max-w-md mx-auto mb-8 leading-relaxed">
      你访问的地址可能已迁移，或者网址输入有误。不过别担心，柴米油盐的生活还在继续，实验室随时欢迎你。
    </p>

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/"
        class="btn-tactile bg-[#E05A2B] hover:bg-[#C9491D] text-[#FAF7F2] px-6 py-3.5 rounded-xl font-bold text-sm"
      >
        ← 返回实验大厅主页
      </a>
      <a
        href="/about"
        class="btn-tactile bg-[#FAF7F2] hover:bg-[#EFEBE4] text-[#181715] px-5 py-3 rounded-xl font-bold text-sm"
      >
        关于《日常AI》
      </a>
    </div>

    <div class="mt-12 pt-8 border-t border-[#E6E0D6] grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs font-mono">
      <a href="/category/life-labs" class="clay-chip p-2.5 bg-[#FAF7F2] border-2 border-[#181715] hover:border-[#E05A2B]">
        🧪 生活实验
      </a>
      <a href="/category/workflows" class="clay-chip p-2.5 bg-[#FAF7F2] border-2 border-[#181715] hover:border-[#E05A2B]">
        ⚡ 日常工作流
      </a>
      <a href="/category/habit-shifts" class="clay-chip p-2.5 bg-[#FAF7F2] border-2 border-[#181715] hover:border-[#E05A2B]">
        🧠 习惯进化
      </a>
      <a href="/category/my-stack" class="clay-chip p-2.5 bg-[#FAF7F2] border-2 border-[#181715] hover:border-[#E05A2B]">
        🧰 实用工具箱
      </a>
    </div>
  </div>
</BaseLayout>
