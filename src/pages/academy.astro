    <script is:inline>
      function switchChatVideo(type) {
        const video = document.getElementById('chat-showcase-video');
        const source = document.getElementById('chat-video-source');
        const dlBtn = document.getElementById('video-download-btn');
        const tabPhoto = document.getElementById('tab-video-photo');
        const tabAsi = document.getElementById('tab-video-asi');

        if (!video || !source) return;

        if (type === 'photo') {
          source.src = '/videos/class-photo-chat.mp4';
          video.poster = '/videos/class-photo-chat-poster.jpg';
          if (dlBtn) dlBtn.href = '/videos/class-photo-chat.mp4';
          
          tabPhoto.className = 'text-left p-3 rounded-xl border-2 transition-all flex flex-col justify-between border-[#E05A2B] bg-[#E05A2B]/15 text-white';
          tabAsi.className = 'text-left p-3 rounded-xl border-2 border-white/10 hover:border-white/30 bg-white/5 text-white/80 hover:text-white transition-all flex flex-col justify-between';
        } else {
          source.src = '/videos/asi-ban-chat.mp4';
          video.poster = '/videos/asi-ban-chat-poster.jpg';
          if (dlBtn) dlBtn.href = '/videos/asi-ban-chat.mp4';
          
          tabAsi.className = 'text-left p-3 rounded-xl border-2 transition-all flex flex-col justify-between border-[#E05A2B] bg-[#E05A2B]/15 text-white';
          tabPhoto.className = 'text-left p-3 rounded-xl border-2 border-white/10 hover:border-white/30 bg-white/5 text-white/80 hover:text-white transition-all flex flex-col justify-between';
        }

        video.load();
        video.play().catch(e => {
          // Autoplay policy fallback
          console.log('Video loaded. Ready for user click.');
        });
      }
