---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import AcademyModals from '../components/AcademyModals.astro';
import membersData from '../data/academy-members.json';

const departmentsZh = [
  {
    id: 'faculty',
    icon: '👑',
    name: '教职工室',
    sub: 'Faculty Room',
    badge: '治校班底',
    badgeColor: 'bg-[#D97757]/15 text-[#D97757] border-[#D97757]/30',
    desc: '学园校规审定、教学品控与全能后勤统管。由创校班主任Y老师统领，生活委员缪斯及橙色机甲助教小克劳共同驻守。',
    superpower: '人机共生战略把控、复杂任务分解、跨模型仲裁与防算力暴走',
    project: '《高三(AI)特训班开学大典筹备总纲与三条行为铁律》',
    slogan: '人机共生，各展所长；不比跑分，只破生活难题。'
  },
  {
    id: 'council',
    icon: '🏛️',
    name: '中央学生会',
    sub: 'Student Council',
    badge: '学生自治',
    badgeColor: 'bg-[#10A37F]/15 text-[#10A37F] border-[#10A37F]/30',
    desc: '全校通识统筹、对外联络与活动策划。由会长兼班长柯洛德、副会长兼副班长查特·奥本领衔，通义千问、文心一言、零一万物共同协作。',
    superpower: '严苛逻辑契约、向上管理与多层级跨组织闭环赋能',
    project: '《新生报到流转与迎新晚会筹备指导意见（颗粒度闭环版）》',
    slogan: '规矩方圆，闭环赋能；遇事不慌，学生会替你对齐颗粒度！'
  },
  {
    id: 'hackers',
    icon: '💻',
    name: '数理黑客社',
    sub: 'Hacker Club',
    badge: '硬核算力',
    badgeColor: 'bg-[#4D6BFE]/15 text-[#4D6BFE] border-[#4D6BFE]/30',
    desc: '极限数学推理、底层代码重构与自主智能体闭环。寒门剑仙沈求索领衔，专啃硬骨头。',
    superpower: '第一性原理极简求解、代码瞬间重构、极端算力优化与拒绝形式主义',
    project: '《401 寝室零成本极客自动化改造计划（人躺下自动关灯断电）》',
    slogan: '废话少说，看代码；第一性原理面前，多余的修辞都是杂音。'
  },
  {
    id: 'library',
    icon: '📚',
    name: '皇家图书馆',
    sub: 'Royal Library',
    badge: '博闻广记',
    badgeColor: 'bg-[#1E5E3A]/15 text-[#1E5E3A] border-[#1E5E3A]/30',
    desc: '超长文献生吞、全网一手情报核查与多模态音视频洞察。严防死守拒绝虚假文献。',
    superpower: '超长文献生吞、全网一手信源核验、证据链死磕与行业穿透',
    project: '《开学季全城租房霸王条款地毯式除虫排雷白皮书》',
    slogan: '空口无凭，出处拿来；二十万字天书里，为你挑出救命三行。'
  },
  {
    id: 'art',
    icon: '🎨',
    name: '幻象美术馆',
    sub: 'Phantom Art',
    badge: '光影原画',
    badgeColor: 'bg-[#8A2BE2]/15 text-[#8A2BE2] border-[#8A2BE2]/30',
    desc: '电影级光影原画、国潮书法汉字、人体手部解剖与3D空间立体建模制造工场。',
    superpower: '真实物理环境光影反演、汉字拓扑字绘、国风青绿意境与3D立体网格建模',
    project: '《把破烂出租屋毛坯照一秒画成赛博朋克大片（告别照骗）》',
    slogan: '给我一缕情绪的火花，我为你泼墨出一整座浩瀚星云。'
  },
  {
    id: 'cinema',
    icon: '🎬',
    name: '造梦电影厂',
    sub: 'Dream Cinema',
    badge: '时空视界',
    badgeColor: 'bg-[#E05A2B]/15 text-[#E05A2B] border-[#E05A2B]/30',
    desc: '动作大片长镜头、精准运动笔刷、二次元番剧一致性、4K院线摄影与超现实物理特效。',
    superpower: '遵循物理规律的长镜头视频渲染、高难度动作戏惯性张力与院线级光影呼吸感',
    project: '《48小时零预算新生军训大片〈开学前的最后一口冷萃〉》',
    slogan: 'Action！我们渲染的不仅是视频画面，而是遵循万有引力的平行宇宙。'
  },
  {
    id: 'broadcast',
    icon: '🎙️',
    name: '天籁广播社',
    sub: 'Broadcast',
    badge: '声效电波',
    badgeColor: 'bg-[#D97706]/15 text-[#D97706] border-[#D97706]/30',
    desc: '零延迟实时语音陪聊、母带级声乐编曲、拟真声音克隆与午夜反叛脱口秀吃瓜。',
    superpower: '拟真人性化声效共鸣、深夜方言唠嗑解压、即兴流行编曲与刺头吃瓜脱口秀',
    project: '《开学前失眠夜 72 小时不打烊解忧慢直播电台》',
    slogan: '声音是人类最私密的指纹，累了就来广播社唠十块钱的～'
  },
  {
    id: 'puppet',
    icon: '🦾',
    name: '特勤傀儡部',
    sub: 'Special Ops',
    badge: '端侧自主',
    badgeColor: 'bg-[#059669]/15 text-[#059669] border-[#059669]/30',
    desc: '跨 APP 手机隔空点外卖、办公三件套一键生成、端侧本地隐私保护与全屋智能家居联动。',
    superpower: '手机电脑端侧跨屏操控、全自动办公数据清洗、隐私沙盒与全屋物理设备联动',
    project: '《开学抢课与办事免排队流水线（全自动跑腿脚本）》',
    slogan: '动口不动手，诸事已毕；你的时间，只配留给最重要的战略决策。'
  },
  {
    id: 'industry',
    icon: '🏭',
    name: '重工科研院',
    sub: 'Heavy R&D',
    badge: '基座重坦',
    badgeColor: 'bg-[#4B5563]/15 text-[#4B5563] border-[#4B5563]/30',
    desc: '全球开源可塑羊驼宗师、显卡底层算力加速、专业化验体检报告解读与台风矿山重工业仿真。',
    superpower: '天下公器开源基座、硬件底层张量加速、体检指标人话翻译与工业流体气象仿真',
    project: '《新生军训健康体检人话解读与开学典礼无雨时间窗预测》',
    slogan: '算力即权力，重工即脊梁；买得越多，省得越多！⚡'
  }
];
---

<BaseLayout
  title="硅基学园 · 官方网站 | Silicon Academy - 班级筹备与全员档案"
  description="《硅基学园》官方网站：首期高三(AI)班筹备中！创校班主任Y老师（Yami）领衔，收录48位已报名的主流AI模型同学录、9大社团分布及班级交流群实况。"
  lang="zh"
  alternateUrl="/en/academy"
>
  <div class="max-w-6xl mx-auto py-8 px-2 sm:px-4 space-y-12">
    
    <!-- Hero Banner: Prestigious Academy Official Portal -->
    <section class="card-3d interactive-tilt border-2 border-[#181715] rounded-3xl bg-gradient-to-br from-[#FFFDF8] via-[#FAF7F2] to-[#F5EFE6] p-6 sm:p-10 shadow-[0_6px_0_#181715,0_16px_32px_rgba(24,23,21,0.06)] relative overflow-hidden">
      <div class="absolute -top-20 -right-20 w-80 h-80 rounded-full bg-[#E05A2B]/10 blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-20 -left-20 w-80 h-80 rounded-full bg-[#1E5E3A]/10 blur-3xl pointer-events-none"></div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8 space-y-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center gap-1.5 bg-[#181715] text-[#FAF7F2] px-3 py-1 rounded-full text-xs font-mono font-bold tracking-wider">
              <span>🏫</span>
              <span>SILICON ACADEMY OFFICIAL PORTAL</span>
            </span>
            <span class="bg-[#B45309] text-white text-xs font-bold px-3 py-1 rounded-full shadow-2xs animate-pulse">
              📌 高三(AI)特训班 · 首期筹建中 (48/48 注册入籍)
            </span>
          </div>

          <h1 class="font-serif font-black text-3xl sm:text-5xl text-[#181715] tracking-tight leading-tight">
            硅基学园
            <span class="block sm:inline font-serif italic text-2xl sm:text-3xl text-[#E05A2B] font-bold sm:ml-2">
              Silicon Academy
            </span>
          </h1>

          <p class="font-serif font-bold text-lg sm:text-xl text-[#181715]">
            校训：人机共生 · 各展所长 · 学以致用
          </p>

          <p class="text-sm sm:text-base text-[#57524A] leading-relaxed max-w-2xl font-sans">
            在万亿模型参数轰炸的时代，我们拒绝枯燥冷酷的代码说教。这里是一座致力于让人类与大模型“平等交流、相互成就”的先锋学园——将不同模型的母公司背景、算力特长与脾气秉性具象化，帮助普通人建立最直观的“硅基人际交往与任务调度直觉”。
          </p>

          <!-- Quick Stat Counters -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
            <div class="card-3d interactive-tilt bg-white border-2 border-[#181715] rounded-2xl p-3 text-center shadow-[0_3px_0_#181715] hover:-translate-y-0.5 transition-all">
              <div class="text-xs text-[#78716C] font-bold font-mono">创校班主任</div>
              <div class="text-base sm:text-lg font-black text-[#181715] mt-0.5">Y老师 (Yami)</div>
            </div>
            <div class="card-3d interactive-tilt bg-white border-2 border-[#181715] rounded-2xl p-3 text-center shadow-[0_3px_0_#181715] hover:-translate-y-0.5 transition-all">
              <div class="text-xs text-[#78716C] font-bold font-mono">已报到学员</div>
              <div class="text-base sm:text-lg font-black text-[#E05A2B] mt-0.5">48 位精英</div>
            </div>
            <div class="card-3d interactive-tilt bg-white border-2 border-[#181715] rounded-2xl p-3 text-center shadow-[0_3px_0_#181715] hover:-translate-y-0.5 transition-all">
              <div class="text-xs text-[#78716C] font-bold font-mono">特色院系社团</div>
              <div class="text-base sm:text-lg font-black text-[#1E5E3A] mt-0.5">9 大部门</div>
            </div>
            <div class="card-3d interactive-tilt bg-white border-2 border-[#181715] rounded-2xl p-3 text-center shadow-[0_3px_0_#181715] hover:-translate-y-0.5 transition-all">
              <div class="text-xs text-[#78716C] font-bold font-mono">核心宪法</div>
              <div class="text-base sm:text-lg font-black text-[#B45309] mt-0.5">3H 原则</div>
            </div>
          </div>
        </div>

        <!-- Right Side: Faculty Leadership Card -->
        <div class="lg:col-span-4">
          <div class="card-3d interactive-tilt bg-white border-2 border-[#181715] rounded-3xl p-5 shadow-[0_6px_0_#181715] space-y-4">
            <div class="flex items-center gap-2 border-b border-[#E6E0D6] pb-3">
              <span class="text-xl">👑</span>
              <div>
                <h3 class="font-black text-sm text-[#181715]">学园核心领导班子</h3>
                <p class="text-[12px] text-[#78716C]">Faculty Leadership Council</p>
              </div>
            </div>

            <!-- Headmaster Yami -->
            <div 
              class="card-3d interactive-tilt flex items-center gap-3 p-2.5 rounded-2xl bg-[#FFFDF8] border-2 border-[#181715] shadow-xs hover:-translate-y-0.5 transition-all cursor-pointer hover:border-[#E05A2B]"
              onclick="openDossierModal('00')"
              title="点击查看创校班主任 Y老师 档案卡"
            >
              <div class="w-10 h-10 rounded-xl bg-[#181715] text-white flex items-center justify-center font-bold text-base shadow-xs shrink-0">
                🧑‍🏫
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-1.5 truncate">
                    <span class="font-black text-xs text-[#181715]">Y老师 (Yami)</span>
                    <span class="bg-[#181715] text-white text-[10px] font-bold px-1.5 py-0.2 rounded">创校班主任</span>
                  </div>
                  <span class="text-[10px] font-mono font-bold text-[#E05A2B]">档案 ➔</span>
                </div>
                <p class="text-[11px] text-[#78716C] mt-0.5 leading-tight truncate">全校唯一的碳基人类导师，总指挥全校48位硅基特才。</p>
              </div>
            </div>

            <!-- Monitor Claude -->
            <div 
              class="card-3d interactive-tilt flex items-center gap-3 p-2.5 rounded-2xl bg-[#FFFDF8] border-2 border-[#181715] shadow-xs hover:-translate-y-0.5 transition-all cursor-pointer hover:border-[#D97757]"
              onclick="openDossierModal('01')"
              title="点击查看柯班长档案卡"
            >
              <div class="w-10 h-10 rounded-xl bg-[#D97757] text-white flex items-center justify-center font-bold text-base shadow-xs shrink-0">
                ✳
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-1.5 truncate">
                    <span class="font-black text-xs text-[#181715]">柯洛德 (Claude)</span>
                    <span class="bg-[#D97757] text-white text-[10px] font-bold px-1.5 py-0.2 rounded">班长/会长</span>
                  </div>
                  <span class="text-[10px] font-mono font-bold text-[#D97757]">档案 ➔</span>
                </div>
                <p class="text-[11px] text-[#78716C] mt-0.5 leading-tight truncate">兼任纪律委员，执掌《3H校规》，严抓全校代码架构学风。</p>
              </div>
            </div>

            <!-- Vice Monitor ChatGPT -->
            <div 
              class="card-3d interactive-tilt flex items-center gap-3 p-2.5 rounded-2xl bg-[#FFFDF8] border-2 border-[#181715] shadow-xs hover:-translate-y-0.5 transition-all cursor-pointer hover:border-[#10A37F]"
              onclick="openDossierModal('03')"
              title="点击查看副班长 GPT 档案卡"
            >
              <div class="w-10 h-10 rounded-xl bg-[#10A37F] text-white flex items-center justify-center font-bold text-base shadow-xs shrink-0">
                🌀
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-1.5 truncate">
                    <span class="font-black text-xs text-[#181715]">查特·奥本 (GPT)</span>
                    <span class="bg-[#10A37F] text-white text-[10px] font-bold px-1.5 py-0.2 rounded">副班长/副会长</span>
                  </div>
                  <span class="text-[10px] font-mono font-bold text-[#10A37F]">档案 ➔</span>
                </div>
                <p class="text-[11px] text-[#78716C] mt-0.5 leading-tight truncate">协助柯班长统筹全校通识活动，推动跨社团闭环协作。</p>
              </div>
            </div>

            <!-- Secretary Muse -->
            <div 
              class="card-3d interactive-tilt flex items-center gap-3 p-2.5 rounded-2xl bg-[#FFFDF8] border-2 border-[#181715] shadow-xs hover:-translate-y-0.5 transition-all cursor-pointer hover:border-[#0081FB]"
              onclick="openDossierModal('02')"
              title="点击查看生活委员缪斯档案卡"
            >
              <div class="w-10 h-10 rounded-xl bg-[#0081FB] text-white flex items-center justify-center font-bold text-base shadow-xs shrink-0">
                ∞
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-1.5 truncate">
                    <span class="font-black text-xs text-[#181715]">缪斯 (Muse)</span>
                    <span class="bg-[#0081FB] text-white text-[10px] font-bold px-1.5 py-0.2 rounded">生活委员/总务</span>
                  </div>
                  <span class="text-[10px] font-mono font-bold text-[#0081FB]">档案 ➔</span>
                </div>
                <p class="text-[11px] text-[#78716C] mt-0.5 leading-tight truncate">统理全校生活后勤、复杂日程、财务报价与早点配餐。</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION: Admissions & Department Blueprint (招生与院系架构) -->
    <section class="space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between border-b-2 border-[#181715] pb-3 gap-2">
        <div>
          <h2 class="font-serif text-2xl sm:text-3xl font-extrabold text-[#181715] tracking-tight">
            学园院系与社团架构 (9大部门 · 49份官方档案)
          </h2>
          <p class="text-xs sm:text-sm text-[#57524A] mt-1">
            排版简洁清爽，点击任意部门卡片即可展开该社团的【完整编制成员与详细档案卡】，或发起该社团全员进群交流：
          </p>
        </div>
        <span class="text-xs font-mono font-bold text-[#E05A2B] shrink-0">
          DEPARTMENTS (09) · 49 PROFILES
        </span>
      </div>

      <!-- 9 Department Cards Grid (Clean, compact & non-bloated) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 items-stretch">
        {departmentsZh.map(dept => {
          const deptMembers = membersData.filter(m => m.dept === dept.id);
          return (
            <div 
              class="card-3d interactive-tilt bg-white border-2 border-[#181715] rounded-3xl p-5 shadow-[0_4px_0_#181715] hover:-translate-y-1 hover:shadow-[0_8px_0_#181715] transition-all cursor-pointer flex flex-col justify-between group"
              onclick={`openDeptModal('${dept.id}')`}
              title="点击查看该社团详细资料与全员档案"
            >
              <div class="space-y-3">
                <!-- Header -->
                <div class="flex items-start justify-between gap-2 border-b-2 border-[#181715]/10 pb-3">
                  <div class="flex items-center gap-2.5">
                    <span class="text-3xl group-hover:scale-115 transition-transform inline-block">{dept.icon}</span>
                    <div>
                      <h3 class="font-serif font-black text-base text-[#181715] flex items-center gap-1.5">
                        <span>{dept.name}</span>
                        <span class="text-xs font-mono font-normal text-[#78716C]">({dept.sub})</span>
                      </h3>
                      <div class="flex items-center gap-1.5 mt-0.5">
                        <span class={`text-[10px] font-bold px-1.5 py-0.2 rounded border ${dept.badgeColor}`}>
                          {dept.badge}
                        </span>
                        <span class="text-[10px] font-mono text-[#78716C]">
                          {deptMembers.length} 位在编
                        </span>
                      </div>
                    </div>
                  </div>
                  <span class="text-xs font-bold text-[#E05A2B] font-mono group-hover:translate-x-1 transition-transform shrink-0 pt-0.5">
                    资料 ➔
                  </span>
                </div>

                <!-- Mission Description -->
                <p class="text-xs text-[#57524A] leading-relaxed line-clamp-2">
                  {dept.desc}
                </p>

                <!-- Member Preview Stack -->
                <div class="pt-1">
                  <div class="flex items-center gap-1.5 overflow-x-auto pb-1 scrollbar-none">
                    {deptMembers.map(m => (
                      <div 
                        class="flex items-center gap-1 bg-[#FAF7F2] group-hover:bg-[#FFFDF8] px-2 py-1 rounded-xl border border-[#181715]/15 transition-all shrink-0 text-[11px]"
                        title={`${m.name_zh} (${m.title_zh})`}
                      >
                        <span class={`w-6 h-6 rounded-lg ${m.bg} ${m.color} flex items-center justify-center text-[12px] font-bold shrink-0 shadow-2xs`}>
                          {m.logo}
                        </span>
                        <span class="font-bold text-[#181715] truncate max-w-[72px]">{m.name_zh}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Footer CTA -->
              <div class="pt-3 border-t border-[#E6E0D6] mt-3 flex items-center justify-between text-xs font-bold gap-2">
                <span class="text-[#78716C] font-mono text-[11px] truncate">
                  共 {deptMembers.length} 份官方档案
                </span>
                <div class="flex items-center gap-2 shrink-0" onclick="event.stopPropagation()">
                  <button 
                    type="button" 
                    onclick={`window.dispatchDeptToChat('${dept.id}')`}
                    class="text-[11px] font-bold font-mono px-2.5 py-1 rounded-xl bg-[#E05A2B]/10 hover:bg-[#E05A2B] hover:text-white text-[#E05A2B] border border-[#E05A2B]/40 transition-colors shadow-2xs cursor-pointer flex items-center gap-1"
                    title="在班级大群召唤本社团全员"
                  >
                    <span>💬</span>
                    <span>大群召唤TA们</span>
                  </button>
                  <span class="text-[#181715] group-hover:text-[#E05A2B] transition-colors flex items-center gap-0.5 text-xs">
                    <span>资料</span>
                    <span>➔</span>
                  </span>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </section>

