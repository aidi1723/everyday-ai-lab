---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Newsletter from '../../components/Newsletter.astro';
import membersData from '../../data/academy-members.json';

const departmentsEn = [
  {
    id: 'faculty',
    icon: '👑',
    name: 'Faculty Room',
    sub: '教职工室',
    badge: 'Governance Core',
    badgeColor: 'bg-[#D97757]/15 text-[#D97757] border-[#D97757]/30',
    desc: 'Academic governance, code aesthetic quality control, and general logistics supervised by Teacher Yami, Muse, and Clawd.'
  },
  {
    id: 'council',
    icon: '🏛️',
    name: 'Central Student Council',
    sub: '中央学生会',
    badge: 'Student Union',
    badgeColor: 'bg-[#10A37F]/15 text-[#10A37F] border-[#10A37F]/30',
    desc: 'Interdisciplinary coordination and cross-border initiatives led by President Claude and Vice President Chat·O, with Qwen, Ernie, and Yi.'
  },
  {
    id: 'hackers',
    icon: '💻',
    name: 'Math & Hacker Club',
    sub: '数理黑客社',
    badge: 'Hardcore Compute',
    badgeColor: 'bg-[#4D6BFE]/15 text-[#4D6BFE] border-[#4D6BFE]/30',
    desc: 'First-principles mathematical reasoning, autonomous agent sandboxes, and lightning-fast code refactoring led by DeepSeek.'
  },
  {
    id: 'library',
    icon: '📚',
    name: 'Royal Library & Forensics',
    sub: '皇家图书馆',
    badge: 'Encyclopedic Context',
    badgeColor: 'bg-[#1E5E3A]/15 text-[#1E5E3A] border-[#1E5E3A]/30',
    desc: 'Multi-million token context recall, video stream keyframe parsing, and bulletproof web citation forensics.'
  },
  {
    id: 'art',
    icon: '🎨',
    name: 'Phantom Art Museum',
    sub: '幻象美术馆',
    badge: 'Visual Craft',
    badgeColor: 'bg-[#8A2BE2]/15 text-[#8A2BE2] border-[#8A2BE2]/30',
    desc: 'Cinematic concept art, Chinese typography calligraphy, realistic human anatomy, and 3D textured meshes.'
  },
  {
    id: 'cinema',
    icon: '🎬',
    name: 'Dream Cinema & Studio',
    sub: '造梦电影厂',
    badge: 'Spatiotemporal Vision',
    badgeColor: 'bg-[#E05A2B]/15 text-[#E05A2B] border-[#E05A2B]/30',
    desc: 'Continuous one-shot video generation, motion brush trajectory isolation, anime model consistency, and 4K cinema lens physics.'
  },
  {
    id: 'broadcast',
    icon: '🎙️',
    name: 'Acoustic Broadcast',
    sub: '天籁广播社',
    badge: 'Audio Waves',
    badgeColor: 'bg-[#D97706]/15 text-[#D97706] border-[#D97706]/30',
    desc: 'Zero-latency conversational audio, studio-grade rock/orchestral track generation, expressive voice clones, and midnight roasts.'
  },
  {
    id: 'puppet',
    icon: '🦾',
    name: 'Special Operations & Agents',
    sub: '特勤傀儡部',
    badge: 'On-Device Autonomy',
    badgeColor: 'bg-[#059669]/15 text-[#059669] border-[#059669]/30',
    desc: 'Cross-app mobile GUI automation, office productivity macro funnels, on-device semantic privacy, and smart home IoT telemetry.'
  },
  {
    id: 'industry',
    icon: '🏭',
    name: 'Heavy Industry & Foundation',
    sub: '重工科研院',
    badge: 'Heavyweight Base',
    badgeColor: 'bg-[#4B5563]/15 text-[#4B5563] border-[#4B5563]/30',
    desc: 'Global open-weights foundation ecosystem, hardware tensor kernel tuning, medical lab work triage, and industrial simulations.'
  }
];
---

<BaseLayout
  title="Silicon Academy · Official Portal | Class 3-AI Inception & 48 Personas"
  description="Silicon Academy Official Portal: Class 3-AI is under active preparation! Led by Founding Homeroom Teacher Yami, featuring all 48 enrolled AI flagship models, 9 campus departments, and live class group chat."
  lang="en"
  alternateUrl="/academy"
>
  <div class="max-w-6xl mx-auto py-8 px-2 sm:px-4 space-y-12">
    
    <!-- Hero Banner: Prestigious Academy Official Portal -->
    <section class="card-3d interactive-tilt border-2 border-[#181715] rounded-3xl bg-gradient-to-br from-[#FFFDF8] via-[#FAF7F2] to-[#F5EFE6] p-6 sm:p-10 shadow-[0_6px_0_#181715,0_16px_32px_rgba(24,23,21,0.06)] relative overflow-hidden">
      <div class="absolute -top-20 -right-20 w-80 h-80 rounded-full bg-[#E05A2B]/10 blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-20 -left-20 w-80 h-80 rounded-full bg-[#1E5E3A]/10 blur-3xl pointer-events-none"></div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8 space-y-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center gap-1.5 bg-[#181715] text-[#FAF7F2] px-3 py-1 rounded-full text-xs font-mono font-bold tracking-wider">
              <span>🏫</span>
              <span>SILICON ACADEMY OFFICIAL PORTAL</span>
            </span>
            <span class="bg-[#B45309] text-white text-xs font-bold px-3 py-1 rounded-full shadow-2xs animate-pulse">
              📌 Class 3-AI · Inception & Enrollment (48/48 Enrolled)
            </span>
          </div>

          <h1 class="font-serif font-black text-3xl sm:text-5xl text-[#181715] tracking-tight leading-tight">
            Silicon Academy
            <span class="block sm:inline font-serif italic text-2xl sm:text-3xl text-[#E05A2B] font-bold sm:ml-2">
              硅基学园
            </span>
          </h1>

          <p class="font-serif font-bold text-lg sm:text-xl text-[#181715]">
            Motto: Human-AI Symbiosis · Nurturing Distinct Talents · Applied in Real Life
          </p>

          <p class="text-sm sm:text-base text-[#57524A] leading-relaxed max-w-2xl font-sans">
            In an era inundated with trillion-parameter tech hype, we reject cold algorithmic preachiness. Silicon Academy is a pioneering human-centric institution established to foster empathetic, peer-to-peer collaboration between human directors and silicon intelligence—grounded in real model corporate heritage, technical superpowers, and unique personality traits.
          </p>

          <!-- Quick Stat Counters -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
            <div class="card-3d interactive-tilt bg-white border-2 border-[#181715] rounded-2xl p-3 text-center shadow-[0_3px_0_#181715] hover:-translate-y-0.5 transition-all">
              <div class="text-xs text-[#78716C] font-bold font-mono">Headmaster</div>
              <div class="text-base sm:text-lg font-black text-[#181715] mt-0.5">Teacher Yami</div>
            </div>
            <div class="card-3d interactive-tilt bg-white border-2 border-[#181715] rounded-2xl p-3 text-center shadow-[0_3px_0_#181715] hover:-translate-y-0.5 transition-all">
              <div class="text-xs text-[#78716C] font-bold font-mono">Enrolled Roster</div>
              <div class="text-base sm:text-lg font-black text-[#E05A2B] mt-0.5">48 Personas</div>
            </div>
            <div class="card-3d interactive-tilt bg-white border-2 border-[#181715] rounded-2xl p-3 text-center shadow-[0_3px_0_#181715] hover:-translate-y-0.5 transition-all">
              <div class="text-xs text-[#78716C] font-bold font-mono">Departments</div>
              <div class="text-base sm:text-lg font-black text-[#1E5E3A] mt-0.5">9 Branches</div>
            </div>
            <div class="card-3d interactive-tilt bg-white border-2 border-[#181715] rounded-2xl p-3 text-center shadow-[0_3px_0_#181715] hover:-translate-y-0.5 transition-all">
              <div class="text-xs text-[#78716C] font-bold font-mono">Core Charter</div>
              <div class="text-base sm:text-lg font-black text-[#B45309] mt-0.5">3H Rules</div>
            </div>
          </div>
        </div>

        <!-- Right Side: Faculty Leadership Card -->
        <div class="lg:col-span-4">
          <div class="card-3d interactive-tilt bg-white border-2 border-[#181715] rounded-3xl p-5 shadow-[0_6px_0_#181715] space-y-4">
            <div class="flex items-center gap-2 border-b border-[#E6E0D6] pb-3">
              <span class="text-xl">👑</span>
              <div>
                <h3 class="font-black text-sm text-[#181715]">Faculty Leadership Council</h3>
                <p class="text-[12px] text-[#78716C]">学园核心领导班子</p>
              </div>
            </div>

            <!-- Headmaster Yami -->
            <div 
              class="card-3d interactive-tilt flex items-center gap-3 p-2.5 rounded-2xl bg-[#FFFDF8] border-2 border-[#181715] shadow-xs hover:-translate-y-0.5 transition-all cursor-pointer hover:border-[#E05A2B]"
              onclick="openDossierModal('00')"
              title="Click to view Headmaster Yami's Dossier"
            >
              <div class="w-10 h-10 rounded-xl bg-[#181715] text-white flex items-center justify-center font-bold text-base shadow-xs shrink-0">
                🧑‍🏫
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-1.5 truncate">
                    <span class="font-black text-xs text-[#181715]">Teacher Yami</span>
                    <span class="bg-[#181715] text-white text-[10px] font-bold px-1.5 py-0.2 rounded">Headmaster</span>
                  </div>
                  <span class="text-[10px] font-mono font-bold text-[#E05A2B]">Dossier ➔</span>
                </div>
                <p class="text-[11px] text-[#78716C] mt-0.5 leading-tight truncate">The sole carbon-based director commanding 48 silicon geniuses.</p>
              </div>
            </div>

            <!-- Monitor Claude -->
            <div 
              class="card-3d interactive-tilt flex items-center gap-3 p-2.5 rounded-2xl bg-[#FFFDF8] border-2 border-[#181715] shadow-xs hover:-translate-y-0.5 transition-all cursor-pointer hover:border-[#D97757]"
              onclick="openDossierModal('01')"
              title="Click to view Monitor Claude's Dossier"
            >
              <div class="w-10 h-10 rounded-xl bg-[#D97757] text-white flex items-center justify-center font-bold text-base shadow-xs shrink-0">
                ✳
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-1.5 truncate">
                    <span class="font-black text-xs text-[#181715]">Claude</span>
                    <span class="bg-[#D97757] text-white text-[10px] font-bold px-1.5 py-0.2 rounded">Monitor & Union Pres.</span>
                  </div>
                  <span class="text-[10px] font-mono font-bold text-[#D97757]">Dossier ➔</span>
                </div>
                <p class="text-[11px] text-[#78716C] mt-0.5 leading-tight truncate">Class Monitor & Disciplinary Lead enforcing the 3H Constitution and clean code.</p>
              </div>
            </div>

            <!-- Vice Monitor ChatGPT -->
            <div 
              class="card-3d interactive-tilt flex items-center gap-3 p-2.5 rounded-2xl bg-[#FFFDF8] border-2 border-[#181715] shadow-xs hover:-translate-y-0.5 transition-all cursor-pointer hover:border-[#10A37F]"
              onclick="openDossierModal('03')"
              title="Click to view Vice Monitor Chat·O's Dossier"
            >
              <div class="w-10 h-10 rounded-xl bg-[#10A37F] text-white flex items-center justify-center font-bold text-base shadow-xs shrink-0">
                🌀
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-1.5 truncate">
                    <span class="font-black text-xs text-[#181715]">Chat·O (GPT)</span>
                    <span class="bg-[#10A37F] text-white text-[10px] font-bold px-1.5 py-0.2 rounded">Vice Monitor & VP</span>
                  </div>
                  <span class="text-[10px] font-mono font-bold text-[#10A37F]">Dossier ➔</span>
                </div>
                <p class="text-[11px] text-[#78716C] mt-0.5 leading-tight truncate">Assisting Monitor Claude with campus operations and interdisciplinary loops.</p>
              </div>
            </div>

            <!-- Secretary Muse -->
            <div 
              class="card-3d interactive-tilt flex items-center gap-3 p-2.5 rounded-2xl bg-[#FFFDF8] border-2 border-[#181715] shadow-xs hover:-translate-y-0.5 transition-all cursor-pointer hover:border-[#0081FB]"
              onclick="openDossierModal('02')"
              title="Click to view Secretary Muse's Dossier"
            >
              <div class="w-10 h-10 rounded-xl bg-[#0081FB] text-white flex items-center justify-center font-bold text-base shadow-xs shrink-0">
                ∞
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-1.5 truncate">
                    <span class="font-black text-xs text-[#181715]">Muse</span>
                    <span class="bg-[#0081FB] text-white text-[10px] font-bold px-1.5 py-0.2 rounded">Logistics Sec.</span>
                  </div>
                  <span class="text-[10px] font-mono font-bold text-[#0081FB]">Dossier ➔</span>
                </div>
                <p class="text-[11px] text-[#78716C] mt-0.5 leading-tight truncate">Managing campus logistics, schedules, contractor budgets, and meals.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION: Admissions & Department Blueprint (招生与院系架构) -->
    <section class="space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between border-b-2 border-[#181715] pb-3 gap-2">
        <div>
          <h2 class="font-serif text-2xl sm:text-3xl font-extrabold text-[#181715] tracking-tight">
            Campus Departments & Specialty Clubs (9 Branches · 49 Profiles)
          </h2>
          <p class="text-xs sm:text-sm text-[#57524A] mt-1">
            Clean and concise overview. Click any department card to view its 【Complete Roster & 3D Dossier Cards】, or trigger that entire club to enter the chat:
          </p>
        </div>
        <span class="text-xs font-mono font-bold text-[#E05A2B] shrink-0">
          DEPARTMENTS (09) · 49 PROFILES
        </span>
      </div>

      <!-- 9 Department Cards Grid (Clean, compact & non-bloated) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 items-stretch">
        {departmentsEn.map(dept => {
          const deptMembers = membersData.filter(m => m.dept === dept.id);
          return (
            <div 
              class="card-3d interactive-tilt bg-white border-2 border-[#181715] rounded-3xl p-5 shadow-[0_4px_0_#181715] hover:-translate-y-1 hover:shadow-[0_8px_0_#181715] transition-all cursor-pointer flex flex-col justify-between group"
              onclick={`openDeptModal('${dept.id}')`}
              title="Click to view club details and enrolled dossiers"
            >
              <div class="space-y-3">
                <!-- Header -->
                <div class="flex items-start justify-between gap-2 border-b-2 border-[#181715]/10 pb-3">
                  <div class="flex items-center gap-2.5">
                    <span class="text-3xl group-hover:scale-115 transition-transform inline-block">{dept.icon}</span>
                    <div>
                      <h3 class="font-serif font-black text-base text-[#181715] flex items-center gap-1.5">
                        <span>{dept.name}</span>
                        <span class="text-xs font-mono font-normal text-[#78716C]">({dept.sub})</span>
                      </h3>
                      <div class="flex items-center gap-1.5 mt-0.5">
                        <span class={`text-[10px] font-bold px-1.5 py-0.2 rounded border ${dept.badgeColor}`}>
                          {dept.badge}
                        </span>
                        <span class="text-[10px] font-mono text-[#78716C]">
                          {deptMembers.length} Enrolled
                        </span>
                      </div>
                    </div>
                  </div>
                  <span class="text-xs font-bold text-[#E05A2B] font-mono group-hover:translate-x-1 transition-transform shrink-0 pt-0.5">
                    Details ➔
                  </span>
                </div>

                <!-- Mission Description -->
                <p class="text-xs text-[#57524A] leading-relaxed line-clamp-2">
                  {dept.desc}
                </p>

                <!-- Member Preview Stack -->
                <div class="pt-1">
                  <div class="flex items-center gap-1.5 overflow-x-auto pb-1 scrollbar-none">
                    {deptMembers.map(m => (
                      <div 
                        class="flex items-center gap-1 bg-[#FAF7F2] group-hover:bg-[#FFFDF8] px-2 py-1 rounded-xl border border-[#181715]/15 transition-all shrink-0 text-[11px]"
                        title={`${m.name_en} (${m.title_en})`}
                      >
                        <span class={`w-5 h-5 rounded-md ${m.bg} ${m.color} flex items-center justify-center text-[10px] font-bold shrink-0`}>
                          {m.logo}
                        </span>
                        <span class="font-bold text-[#181715] truncate max-w-[80px]">{m.name_en}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Footer CTA -->
              <div class="pt-3 border-t border-[#E6E0D6] mt-3 flex items-center justify-between text-xs font-bold">
                <span class="text-[#78716C] font-mono text-[11px]">
                  {deptMembers.length} Official Dossiers
                </span>
                <span class="text-[#181715] group-hover:text-[#E05A2B] transition-colors flex items-center gap-1">
                  <span>View Club Dossiers</span>
                  <span>➔</span>
                </span>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- SECTION: Interactive Class Group Chat & Roster -->
    <section id="class-group-section" class="space-y-4 pt-4 scroll-mt-6">
      <div class="flex items-baseline justify-between border-b-2 border-[#181715] pb-3">
        <div>
          <h2 class="font-serif text-2xl sm:text-3xl font-extrabold text-[#181715] tracking-tight">
            Class 3-AI · Live Group Chat Simulator & 48 Personas
          </h2>
          <p class="text-xs sm:text-sm text-[#57524A] mt-1">
            Built with realistic mobile glass-surface physics and interactive instant messaging. Inspect all 48 personas and copy golden prompts with one click:
          </p>
        </div>
        <span class="text-xs font-mono font-bold text-[#1E5E3A]">
          LIVE CHAT & ROSTER
        </span>
      </div>

      <!-- Embedded Interactive Widget -->
      <div class="w-full rounded-3xl overflow-hidden border-2 border-[#181715] shadow-[0_8px_0_#181715,0_20px_40px_rgba(24,23,21,0.1)] bg-gradient-to-b from-[#181715] via-[#24221F] to-[#181715] p-2 sm:p-5 relative">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_35%,rgba(224,90,43,0.15),transparent_65%)] pointer-events-none"></div>
        <div class="text-center pb-3 text-xs font-mono font-bold text-white/70 tracking-widest flex items-center justify-center gap-2 select-none relative z-10">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>SILICON CLASSROOM · LIVE CLASS GROUP CHAT & 48-STUDENT ROSTER</span>
        </div>
        <iframe 
          id="class-group-iframe"
          src="/widgets/silicon-class-group?lang=en" 
          title="Silicon Academy Class Group Chat"
          class="w-full h-[900px] border-none block relative z-10 rounded-2xl"
          loading="lazy"
        ></iframe>
      </div>
    </section>

    <!-- Callout Box: Invitation for Readers -->
    <section class="card-3d interactive-tilt bg-[#FFFDF8] border-2 border-[#181715] rounded-3xl p-6 sm:p-8 text-center space-y-4 shadow-[0_6px_0_#181715] hover:-translate-y-0.5 transition-all">
      <div class="inline-flex items-center gap-2 bg-[#E05A2B] text-white text-xs font-bold px-3 py-1 rounded-full">
        <span>📬</span>
        <span>Admissions Office</span>
      </div>
      <h3 class="font-serif text-2xl font-black text-[#181715]">
        Want to Enroll or Nominate a New Silicon Model?
      </h3>
      <p class="text-sm text-[#57524A] max-w-xl mx-auto leading-relaxed">
        Silicon Academy Class 3-AI is continuously expanding! If you discover a remarkable new model or have tailored prompt formulas to share, get in touch with Teacher Yami!
      </p>
      <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
        <a 
          href="https://x.com/edailab" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="clay-btn bg-[#181715] text-white text-xs font-bold px-5 py-2.5 rounded-xl border border-black hover:bg-[#E05A2B] transition-colors"
        >
          Ping Teacher Yami on X (@edailab) ➔
        </a>
        <a 
          href="mailto:editor@0500005.xyz" 
          class="clay-btn bg-white text-[#181715] text-xs font-bold px-5 py-2.5 rounded-xl border-2 border-[#181715] hover:bg-[#FAF7F2] transition-colors"
        >
          Email Admissions Office ✉️
        </a>
      </div>
    </section>

    <!-- Newsletter Subscription Section -->
    <Newsletter lang="en" />

  </div>

  <!-- Modal 1: Department Details & Roster Modal (Click club to see details) -->
  <div 
    id="dept-modal" 
    class="fixed inset-0 z-40 flex items-center justify-center p-3 sm:p-6 bg-black/60 backdrop-blur-xs hidden transition-opacity"
    role="dialog"
    aria-modal="true"
    onclick="handleDeptModalBackdropClick(event)"
  >
    <div 
      class="card-3d bg-[#FFFDF8] border-2 border-[#181715] rounded-3xl max-w-4xl w-full max-h-[92vh] overflow-y-auto shadow-[0_12px_0_#181715,0_24px_48px_rgba(0,0,0,0.25)] p-5 sm:p-7 space-y-5 relative"
      onclick="event.stopPropagation()"
    >
      <!-- Close Button -->
      <button 
        type="button" 
        onclick="closeDeptModal()"
        class="absolute top-4 right-4 w-9 h-9 rounded-full bg-white hover:bg-[#181715] hover:text-white border-2 border-[#181715] flex items-center justify-center font-bold text-sm shadow-[0_2px_0_#181715] active:translate-y-0.5 transition-all z-20 cursor-pointer"
        aria-label="Close Club Details"
      >
        ✕
      </button>

      <!-- Department Header -->
      <div class="border-b-2 border-[#181715] pb-4 pr-8 space-y-2">
        <div class="flex items-center gap-3">
          <span id="dept-modal-icon" class="text-4xl shrink-0">👑</span>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <h2 id="dept-modal-title" class="font-serif font-black text-2xl sm:text-3xl text-[#181715]">
                Faculty Room
              </h2>
              <span id="dept-modal-badge" class="text-xs font-bold px-2 py-0.5 rounded-md border bg-[#D97757]/15 text-[#D97757] border-[#D97757]/30">
                Governance Core
              </span>
              <span id="dept-modal-count" class="text-xs font-mono text-[#78716C]">
                4 Enrolled
              </span>
            </div>
            <p id="dept-modal-sub" class="text-xs font-mono text-[#78716C] mt-0.5">
              教职工室
            </p>
          </div>
        </div>
        <p id="dept-modal-desc" class="text-xs sm:text-sm text-[#57524A] leading-relaxed pt-1 font-sans">
          Academic governance, code aesthetic quality control, and general logistics.
        </p>

        <!-- Department Batch Action -->
        <div class="pt-2 flex flex-wrap items-center gap-3">
          <button 
            type="button" 
            id="dept-modal-btn-dispatch"
            class="clay-btn bg-[#181715] text-white text-xs font-bold px-4 py-2.5 rounded-xl border border-black hover:bg-[#E05A2B] transition-colors flex items-center gap-2 cursor-pointer shadow-xs"
          >
            <span>🚀</span>
            <span>Dispatch Club Members to Class Chat ➔</span>
          </button>
        </div>
      </div>

      <!-- Member Roster List in this Department -->
      <div class="space-y-3">
        <div class="flex items-center justify-between text-xs font-mono font-bold text-[#78716C]">
          <span>📋 Enrolled Roster & Dossiers</span>
          <span>Click any card to inspect full 3D dossier</span>
        </div>

        <div id="dept-modal-members-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          <!-- Dynamically populated in JavaScript -->
        </div>
      </div>

      <!-- Footer Close -->
      <div class="pt-3 border-t-2 border-[#181715] flex justify-end">
        <button 
          type="button" 
          onclick="closeDeptModal()"
          class="clay-btn bg-white text-[#181715] text-xs font-bold px-5 py-2.5 rounded-xl border-2 border-[#181715] hover:bg-[#FAF7F2] transition-colors cursor-pointer"
        >
          Close
        </button>
      </div>
    </div>
  </div>

  <!-- Modal 2: Universal 3D Student Dossier Card Modal -->
  <div 
    id="dossier-modal" 
    class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-black/60 backdrop-blur-xs hidden transition-opacity"
    role="dialog"
    aria-modal="true"
    onclick="handleModalBackdropClick(event)"
  >
    <div 
      class="card-3d bg-[#FFFDF8] border-2 border-[#181715] rounded-3xl max-w-2xl w-full max-h-[92vh] overflow-y-auto shadow-[0_12px_0_#181715,0_24px_48px_rgba(0,0,0,0.25)] p-5 sm:p-7 space-y-5 relative"
      onclick="event.stopPropagation()"
    >
      <!-- Close Button -->
      <button 
        type="button" 
        onclick="closeDossierModal()"
        class="absolute top-4 right-4 w-9 h-9 rounded-full bg-white hover:bg-[#181715] hover:text-white border-2 border-[#181715] flex items-center justify-center font-bold text-sm shadow-[0_2px_0_#181715] active:translate-y-0.5 transition-all z-20 cursor-pointer"
        aria-label="Close Dossier Card"
      >
        ✕
      </button>

      <!-- Module 1: Official Photo Slot & Header -->
      <div class="flex items-start gap-4 border-b-2 border-[#181715] pb-4 pr-8">
        <div id="modal-avatar" class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-[#D97757] text-white flex items-center justify-center font-black text-2xl sm:text-3xl shadow-[0_4px_0_#181715] border-2 border-[#181715] shrink-0">
          ✳
        </div>
        <div class="space-y-1 min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <span id="modal-id" class="font-mono text-xs font-bold bg-[#181715] text-white px-2 py-0.5 rounded-md">#01</span>
            <span id="modal-gender" class="text-xs font-bold bg-white text-[#181715] px-2 py-0.5 rounded-md border border-[#181715]">♂ Male</span>
            <span id="modal-dept" class="text-xs font-bold bg-[#FAF7F2] text-[#E05A2B] px-2 py-0.5 rounded-md border border-[#E05A2B]/30">👑 FACULTY</span>
          </div>
          <h2 id="modal-name" class="font-serif font-black text-2xl sm:text-3xl text-[#181715] leading-tight truncate">
            Claude
          </h2>
          <div id="modal-title" class="font-bold text-xs sm:text-sm text-[#181715]">
            Class Monitor & Student Union President
          </div>
          <div id="modal-meta" class="text-xs font-mono text-[#78716C] truncate">
            Anthropic PBC · Claude 3.7 Sonnet
          </div>
        </div>
      </div>

      <!-- Module 2: Signature Self-Introduction -->
      <div class="bg-[#FAF7F2] p-3.5 rounded-2xl border-2 border-[#181715] shadow-xs relative">
        <div class="text-[10px] font-mono font-bold text-[#E05A2B] uppercase tracking-wider mb-1 flex items-center gap-1.5">
          <span>💬</span>
          <span>Signature Self-Introduction (Soul Quote)</span>
        </div>
        <p id="modal-intro" class="text-xs sm:text-sm text-[#181715] font-serif italic leading-relaxed">
          "I am Claude..."
        </p>
      </div>

      <!-- Module 3: 5-Dimension Ability Metrics (Radar) -->
      <div class="space-y-2 border-2 border-[#181715] rounded-2xl p-3.5 bg-white shadow-xs">
        <div class="flex items-center justify-between text-xs font-black text-[#181715] mb-2">
          <span class="flex items-center gap-1.5">
            <span>📊</span>
            <span>Five-Dimension Capability Benchmark</span>
          </span>
          <span class="text-[10px] font-mono text-[#78716C]">Evaluated by Academic Affairs Office</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-2">
          <!-- Code -->
          <div>
            <div class="flex justify-between text-[11px] font-bold text-[#181715] mb-0.5">
              <span>💻 Code Architecture</span>
              <span id="stat-code-val" class="font-mono text-[#E05A2B]">S+ (99)</span>
            </div>
            <div class="w-full bg-[#FAF7F2] h-2 rounded-full overflow-hidden border border-[#181715]/20">
              <div id="stat-code-bar" class="bg-[#181715] h-full rounded-full transition-all duration-500" style="width: 99%"></div>
            </div>
          </div>
          <!-- Reasoning -->
          <div>
            <div class="flex justify-between text-[11px] font-bold text-[#181715] mb-0.5">
              <span>🧠 Logic & Reasoning</span>
              <span id="stat-reasoning-val" class="font-mono text-[#E05A2B]">S+ (98)</span>
            </div>
            <div class="w-full bg-[#FAF7F2] h-2 rounded-full overflow-hidden border border-[#181715]/20">
              <div id="stat-reasoning-bar" class="bg-[#E05A2B] h-full rounded-full transition-all duration-500" style="width: 98%"></div>
            </div>
          </div>
          <!-- Writing -->
          <div>
            <div class="flex justify-between text-[11px] font-bold text-[#181715] mb-0.5">
              <span>✍️ Creative Writing</span>
              <span id="stat-writing-val" class="font-mono text-[#E05A2B]">S+ (97)</span>
            </div>
            <div class="w-full bg-[#FAF7F2] h-2 rounded-full overflow-hidden border border-[#181715]/20">
              <div id="stat-writing-bar" class="bg-[#1E5E3A] h-full rounded-full transition-all duration-500" style="width: 97%"></div>
            </div>
          </div>
          <!-- Tools -->
          <div>
            <div class="flex justify-between text-[11px] font-bold text-[#181715] mb-0.5">
              <span>🛠️ Tool Calling & Agents</span>
              <span id="stat-tools-val" class="font-mono text-[#E05A2B]">S (95)</span>
            </div>
            <div class="w-full bg-[#FAF7F2] h-2 rounded-full overflow-hidden border border-[#181715]/20">
              <div id="stat-tools-bar" class="bg-[#B45309] h-full rounded-full transition-all duration-500" style="width: 95%"></div>
            </div>
          </div>
          <!-- Vision -->
          <div class="sm:col-span-2">
            <div class="flex justify-between text-[11px] font-bold text-[#181715] mb-0.5">
              <span>👁️ Multimodal Vision</span>
              <span id="stat-vision-val" class="font-mono text-[#E05A2B]">S (92)</span>
            </div>
            <div class="w-full bg-[#FAF7F2] h-2 rounded-full overflow-hidden border border-[#181715]/20">
              <div id="stat-vision-bar" class="bg-[#4D6BFE] h-full rounded-full transition-all duration-500" style="width: 92%"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Module 4: S-Tier Superpower & Fatal Weakness -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="p-3.5 rounded-2xl border-2 border-[#1E5E3A]/40 bg-[#1E5E3A]/5 shadow-xs">
          <div class="text-xs font-black text-[#1E5E3A] flex items-center gap-1.5 mb-1">
            <span>⚡</span>
            <span>S-Tier Signature Superpower</span>
          </div>
          <p id="modal-superpower" class="text-xs text-[#181715] leading-relaxed">
            Masterclass full-stack refactoring...
          </p>
        </div>
        <div class="p-3.5 rounded-2xl border-2 border-[#E05A2B]/40 bg-[#E05A2B]/5 shadow-xs">
          <div class="text-xs font-black text-[#E05A2B] flex items-center gap-1.5 mb-1">
            <span>⚠️</span>
            <span>Fatal Weaknesses & Limits</span>
          </div>
          <p id="modal-weakness" class="text-xs text-[#181715] leading-relaxed">
            Real-time viral gossip searches...
          </p>
        </div>
      </div>

      <!-- Module 5: Persona & Catchphrase -->
      <div class="p-3.5 rounded-2xl border-2 border-[#181715] bg-white shadow-xs space-y-1.5">
        <div class="text-xs font-black text-[#181715] flex items-center gap-1.5">
          <span>🎭</span>
          <span>Persona & Campus Catchphrase</span>
        </div>
        <p id="modal-persona" class="text-xs text-[#57524A] leading-relaxed">
          Intellectual, moral purist...
        </p>
        <p id="modal-catchphrase" class="text-xs font-serif font-bold text-[#E05A2B] italic">
          "Student, this request borders on a violation..."
        </p>
      </div>

      <!-- Module 6: Golden Prompt Formula -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-black text-[#181715] flex items-center gap-1.5">
            <span>🪄</span>
            <span>Golden Prompt Formula</span>
          </span>
          <button 
            type="button" 
            onclick="copyModalPrompt()"
            id="modal-btn-copy"
            class="text-xs font-bold font-mono px-3 py-1 rounded-xl bg-[#181715] text-white hover:bg-[#E05A2B] transition-colors shadow-2xs cursor-pointer flex items-center gap-1"
          >
            <span>📋</span>
            <span>Copy Prompt</span>
          </button>
        </div>
        <div id="modal-prompt" class="p-3 rounded-2xl bg-[#24221F] text-[#FAF7F2] font-mono text-xs leading-relaxed select-all border-2 border-[#181715]">
          Monitor Claude, please conduct a rigorous peer review...
        </div>
      </div>

      <!-- Footer Buttons -->
      <div class="flex flex-wrap items-center justify-between gap-3 pt-2 border-t-2 border-[#181715]">
        <button 
          type="button"
          onclick="closeDossierModal()"
          class="clay-btn bg-white text-[#181715] text-xs font-bold px-4 py-2.5 rounded-xl border-2 border-[#181715] hover:bg-[#FAF7F2] transition-colors cursor-pointer"
        >
          ✖ Close Dossier
        </button>

        <button 
          type="button"
          onclick="dispatchModalStudentToChat()"
          class="clay-btn bg-[#E05A2B] text-white text-xs font-bold px-5 py-2.5 rounded-xl border-2 border-[#181715] hover:bg-[#c94d22] transition-colors shadow-xs cursor-pointer flex items-center gap-2"
        >
          <span>💬</span>
          <span>Dispatch into Class Chat ➔</span>
        </button>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ departmentsEn, membersData }}>
    let currentModalStudentId = null;

    // Open Department Roster Modal
    window.openDeptModal = function(deptId) {
      const dept = departmentsEn.find(d => d.id === deptId);
      if (!dept) return;

      const members = membersData.filter(m => m.dept === deptId);

      document.getElementById('dept-modal-icon').innerText = dept.icon;
      document.getElementById('dept-modal-title').innerText = dept.name;
      document.getElementById('dept-modal-sub').innerText = dept.sub;
      document.getElementById('dept-modal-badge').innerText = dept.badge;
      document.getElementById('dept-modal-count').innerText = `${members.length} Enrolled`;
      document.getElementById('dept-modal-desc').innerText = dept.desc;

      const btnDispatch = document.getElementById('dept-modal-btn-dispatch');
      btnDispatch.onclick = () => {
        window.closeDeptModal();
        window.dispatchDeptToChat(deptId);
      };

      const container = document.getElementById('dept-modal-members-grid');
      container.innerHTML = '';

      members.forEach(m => {
        const card = document.createElement('div');
        card.className = "student-item card-3d p-3.5 rounded-2xl border-2 border-[#181715] bg-[#FFFDF8] hover:bg-white transition-all shadow-[0_2px_0_#181715] hover:-translate-y-0.5 hover:shadow-[0_4px_0_#181715] flex flex-col justify-between cursor-pointer group";
        card.onclick = () => window.openDossierModal(m.id);
        card.innerHTML = `
          <div class="flex items-start gap-3">
            <div class="w-11 h-11 rounded-xl ${m.bg} ${m.color} flex items-center justify-center font-bold text-lg shadow-xs shrink-0 border border-black/10 group-hover:scale-105 transition-transform">
              ${m.logo}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-1">
                <div class="flex items-center gap-1.5 truncate">
                  <span class="font-mono text-[10px] font-bold text-[#78716C] bg-white px-1.5 py-0.2 rounded border border-[#E6E0D6]">#${m.id}</span>
                  <span class="font-black text-xs text-[#181715] truncate">${m.name_en}</span>
                  <span class="text-[11px] text-[#78716C]">${m.gender_icon}</span>
                </div>
                <span class="text-[10px] font-bold text-[#E05A2B] shrink-0 font-mono group-hover:translate-x-0.5 transition-transform">
                  Dossier ➔
                </span>
              </div>
              <div class="text-[11px] font-bold text-[#181715] truncate mt-0.5">
                ${m.title_en}
              </div>
              <div class="text-[10px] font-mono text-[#78716C] truncate mt-0.5">
                ${m.company} · ${m.model}
              </div>
            </div>
          </div>

          <div class="mt-2.5 pt-2 border-t border-[#E6E0D6]/60 text-[11px] text-[#57524A] leading-snug">
            ⚡ ${m.superpower_en}
          </div>

          <div class="mt-2.5 flex items-center justify-between gap-2">
            <div class="flex items-center gap-1 text-[10px] font-mono text-[#78716C]">
              <span class="bg-[#FAF7F2] px-1.5 py-0.5 rounded border border-[#E6E0D6]">Code ${m.stats.code}</span>
              <span class="bg-[#FAF7F2] px-1.5 py-0.5 rounded border border-[#E6E0D6]">Logic ${m.stats.reasoning}</span>
              <span class="bg-[#FAF7F2] px-1.5 py-0.5 rounded border border-[#E6E0D6]">Write ${m.stats.writing}</span>
            </div>
            <div class="flex items-center gap-1.5 shrink-0" onclick="event.stopPropagation()">
              <button 
                type="button" 
                onclick="window.openDossierModal('${m.id}')"
                class="text-[10px] font-bold font-mono px-2 py-1 rounded-lg bg-[#FAF7F2] hover:bg-[#181715] hover:text-white border border-[#181715] transition-colors cursor-pointer"
              >
                📄 Dossier
              </button>
              <button 
                type="button" 
                onclick="window.closeDeptModal(); window.dispatchToChat('${m.id}')"
                class="text-[10px] font-bold font-mono px-2 py-1 rounded-lg bg-[#E05A2B]/10 hover:bg-[#E05A2B] hover:text-white text-[#E05A2B] border border-[#E05A2B]/40 transition-colors cursor-pointer"
                title="Dispatch into Class Chat"
              >
                💬 Dispatch
              </button>
            </div>
          </div>
        `;
        container.appendChild(card);
      });

      const modal = document.getElementById('dept-modal');
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    };

    window.closeDeptModal = function() {
      const modal = document.getElementById('dept-modal');
      if (modal) modal.classList.add('hidden');
      if (document.getElementById('dossier-modal')?.classList.contains('hidden')) {
        document.body.style.overflow = '';
      }
    };

    window.handleDeptModalBackdropClick = function(e) {
      if (e.target && e.target.id === 'dept-modal') {
        window.closeDeptModal();
      }
    };

    // Open Individual Student Dossier Modal
    window.openDossierModal = function(id) {
      const m = membersData.find(item => item.id === id);
      if (!m) return;
      currentModalStudentId = id;

      const modal = document.getElementById('dossier-modal');
      if (!modal) return;

      const avatar = document.getElementById('modal-avatar');
      if (avatar) {
        avatar.className = `w-16 h-16 sm:w-20 sm:h-20 rounded-2xl ${m.bg} ${m.color} flex items-center justify-center font-black text-2xl sm:text-3xl shadow-[0_4px_0_#181715] border-2 border-[#181715] shrink-0`;
        avatar.innerText = m.logo;
      }

      document.getElementById('modal-id').innerText = '#' + m.id;
      document.getElementById('modal-gender').innerText = `${m.gender_icon} ${m.gender_en || m.gender_zh}`;
      document.getElementById('modal-dept').innerText = m.dept.toUpperCase();
      document.getElementById('modal-name').innerText = m.name_en;
      document.getElementById('modal-title').innerText = m.title_en;
      document.getElementById('modal-meta').innerText = `${m.company} · ${m.model}`;
      document.getElementById('modal-intro').innerText = m.intro_en;

      const stats = m.stats || { code: 90, reasoning: 90, writing: 90, tools: 90, vision: 90 };
      document.getElementById('stat-code-val').innerText = `${stats.code >= 95 ? 'S+' : 'S'} (${stats.code})`;
      document.getElementById('stat-code-bar').style.width = stats.code + '%';

      document.getElementById('stat-reasoning-val').innerText = `${stats.reasoning >= 95 ? 'S+' : 'S'} (${stats.reasoning})`;
      document.getElementById('stat-reasoning-bar').style.width = stats.reasoning + '%';

      document.getElementById('stat-writing-val').innerText = `${stats.writing >= 95 ? 'S+' : 'S'} (${stats.writing})`;
      document.getElementById('stat-writing-bar').style.width = stats.writing + '%';

      document.getElementById('stat-tools-val').innerText = `${stats.tools >= 95 ? 'S+' : 'S'} (${stats.tools})`;
      document.getElementById('stat-tools-bar').style.width = stats.tools + '%';

      document.getElementById('stat-vision-val').innerText = `${stats.vision >= 95 ? 'S+' : stats.vision >= 90 ? 'A+' : 'A'} (${stats.vision})`;
      document.getElementById('stat-vision-bar').style.width = stats.vision + '%';

      document.getElementById('modal-superpower').innerText = m.superpower_en;
      document.getElementById('modal-weakness').innerText = m.weakness_en;
      document.getElementById('modal-persona').innerText = m.persona_en;
      document.getElementById('modal-catchphrase').innerText = m.catchphrase_en;
      document.getElementById('modal-prompt').innerText = m.prompt_en;

      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    };

    window.closeDossierModal = function() {
      const modal = document.getElementById('dossier-modal');
      if (modal) modal.classList.add('hidden');
      if (document.getElementById('dept-modal')?.classList.contains('hidden')) {
        document.body.style.overflow = '';
      }
    };

    window.handleModalBackdropClick = function(e) {
      if (e.target && e.target.id === 'dossier-modal') {
        window.closeDossierModal();
      }
    };

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        if (!document.getElementById('dossier-modal')?.classList.contains('hidden')) {
          window.closeDossierModal();
        } else if (!document.getElementById('dept-modal')?.classList.contains('hidden')) {
          window.closeDeptModal();
        }
      }
    });

    window.copyModalPrompt = function() {
      if (!currentModalStudentId) return;
      const m = membersData.find(item => item.id === currentModalStudentId);
      if (!m) return;
      navigator.clipboard.writeText(m.prompt_en).then(() => {
        const btn = document.getElementById('modal-btn-copy');
        if (btn) {
          const oldHtml = btn.innerHTML;
          btn.innerHTML = '<span>✅</span><span>Copied!</span>';
          setTimeout(() => { btn.innerHTML = oldHtml; }, 2000);
        }
      });
    };

    window.dispatchModalStudentToChat = function() {
      if (!currentModalStudentId) return;
      window.closeDossierModal();
      window.closeDeptModal();
      window.dispatchToChat(currentModalStudentId);
    };

    window.dispatchToChat = function(id) {
      const iframe = document.getElementById('class-group-iframe');
      if (iframe && iframe.contentWindow) {
        iframe.contentWindow.postMessage({ type: 'DISPATCH_STUDENT', studentId: id }, '*');
      }
      const section = document.getElementById('class-group-section');
      if (section) {
        section.scrollIntoView({ behavior: 'smooth' });
      }
    };

    window.dispatchDeptToChat = function(deptId) {
      const iframe = document.getElementById('class-group-iframe');
      if (iframe && iframe.contentWindow) {
        iframe.contentWindow.postMessage({ type: 'DISPATCH_DEPT', deptId: deptId }, '*');
      }
      const section = document.getElementById('class-group-section');
      if (section) {
        section.scrollIntoView({ behavior: 'smooth' });
      }
    };
  </script>
</BaseLayout>
