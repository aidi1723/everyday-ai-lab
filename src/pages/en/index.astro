---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PillarGrid from '../../components/PillarGrid.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => {
  return data.lang === 'en';
});

// Sort by pubDate descending, then by issue number
const sortedPosts = allPosts.sort((a, b) => {
  const diff = b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  if (diff !== 0) return diff;
  return (b.data.issue || '').localeCompare(a.data.issue || '');
});
---

<BaseLayout 
  title="Everyday AI Lab | Practical AI Experiments for Everyday Humans"
  description="Only about AI in real life. Actionable experiments, zero-code workflows, and habit shifts for ordinary people."
  lang="en"
  alternateUrl="/"
>
  <!-- Hero Section with Ambient Glows & 3D Artwork -->
  <section class="border-2 border-[#181715] rounded-3xl bg-gradient-to-br from-[#FAF7F2] via-[#FCFBF8] to-[#F5EFE6] p-6 sm:p-10 mb-12 shadow-[0_6px_0_#181715,0_16px_32px_rgba(24,23,21,0.06)] relative overflow-hidden">
    <!-- Ambient Radial Mesh Glows -->
    <div class="absolute -top-24 -right-24 w-80 h-80 rounded-full bg-[#E05A2B]/12 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-80 h-80 rounded-full bg-[#1E5E3A]/8 blur-3xl pointer-events-none"></div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
      <!-- Left Column: Copy -->
      <div class="lg:col-span-7 space-y-5">
        <div class="inline-flex items-center gap-2 bg-[#1E5E3A] text-[#FAF7F2] px-3.5 py-1.5 rounded-full text-xs font-mono font-bold tracking-wider shadow-xs">
          <span>🧪</span>
          <span>HUMAN-CENTRIC AI COLUMN</span>
        </div>

        <div>
          <h1 class="font-serif font-black text-3xl sm:text-5xl text-[#181715] tracking-tight leading-tight">
            Everyday AI Lab
            <span class="block sm:inline font-serif italic text-2xl sm:text-3xl text-[#E05A2B] font-bold sm:ml-3">
              日常AI
            </span>
          </h1>
          <p class="text-base sm:text-xl font-bold text-[#181715] mt-3">
            Only about AI in real life. Practical experiments for everyday humans.
          </p>
          <p class="text-xs sm:text-sm text-[#57524A] font-serif italic mt-1">
            只聊生活中的 AI，记录普通人的日常实践。
          </p>
        </div>

        <p class="text-sm sm:text-base text-[#57524A] leading-relaxed max-w-xl font-sans">
          We don't chase corporate benchmarks or ten-digit funding rounds. This is an open laboratory for real-life living—from saving dinner with leftovers to voice-rant-to-doc workflows and cognitive shifts.
        </p>

        <div class="pt-2 flex flex-wrap items-center gap-4">
          <a 
            href="#posts" 
            class="btn-tactile inline-flex items-center gap-2 bg-[#E05A2B] hover:bg-[#C9491D] text-[#FAF7F2] px-6 py-3.5 rounded-xl font-bold text-sm shadow-[0_4px_0_#181715]"
          >
            <span>Read Field Notes</span>
            <span>↓</span>
          </a>
          <a 
            href="/en/about" 
            class="btn-tactile inline-flex items-center gap-2 bg-[#FAF7F2] hover:bg-[#EFEBE4] text-[#181715] px-5 py-3 rounded-xl font-bold text-sm shadow-[0_4px_0_#181715]"
          >
            About Lab
          </a>
        </div>
      </div>

      <!-- Right Column: Banner Visual Artwork with 3D Tilt -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="card-3d interactive-tilt relative w-full max-w-md rounded-2xl overflow-hidden border-2 border-[#181715] shadow-[0_6px_0_#181715,0_14px_28px_rgba(24,23,21,0.08)] bg-[#EFEBE4]">
          <img 
            src="/images/hero-banner.webp" 
            alt="Everyday AI Lab Hero Banner Artwork" 
            width="1024"
            height="572"
            fetchpriority="high"
            decoding="async"
            class="w-full h-auto object-cover hover:scale-103 transition-transform duration-500"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Four Pillars Section -->
  <PillarGrid lang="en" />

  <!-- Featured / Latest Posts Section -->
  <section id="posts" class="my-16 scroll-mt-24">
    <div class="flex items-baseline justify-between mb-8">
      <div>
        <h2 class="font-serif text-2xl sm:text-3xl font-extrabold text-[#181715] tracking-tight">
          Latest Lab Dispatches
        </h2>
        <p class="text-xs sm:text-sm text-[#57524A] mt-1 font-sans">
          Honest, reproducible, human-centric field notes
        </p>
      </div>
      <span class="text-xs font-mono text-[#1E5E3A] font-bold tracking-wider">
        DISPATCHES ({sortedPosts.length})
      </span>
    </div>

    <!-- Post List Grid -->
    <div class="grid grid-cols-1 gap-8">
      {sortedPosts.map((post) => {
        const words = (post.body || '').split(/\s+/).length;
        const readTimeMin = Math.max(2, Math.ceil(words / 180));
        return (
          <article class="card-3d interactive-tilt bg-[#FAF7F2] border-2 border-[#181715] rounded-2xl p-6 sm:p-8 shadow-[0_4px_0_#181715,0_8px_16px_rgba(24,23,21,0.05)] relative group">
            <div class="flex flex-col md:flex-row gap-6 items-start">
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-2 mb-3">
                  <span class="bg-[#E05A2B] text-[#FAF7F2] text-xs font-mono font-bold px-2.5 py-0.5 rounded-md shadow-2xs">
                    {post.data.issue || 'Issue #00'}
                  </span>
                  <span class="clay-chip bg-[#FFFFFF] border-[1.5px] border-[#181715] text-[#181715] text-xs font-medium px-2.5 py-0.5 rounded-md">
                    {post.data.categoryName || '🧪 Life Labs'}
                  </span>
                  <span class="text-xs font-mono text-[#57524A] bg-[#EFEBE4] px-2 py-0.5 rounded border border-[#D9D2C5]">
                    ⏱️ {readTimeMin} min read
                  </span>
                  <span class="text-xs font-mono text-[#8A847A] ml-auto">
                    {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </span>
                </div>

                <h3 class="font-serif text-xl sm:text-2xl font-bold text-[#181715] group-hover:text-[#E05A2B] transition-colors mb-3 leading-snug">
                  <a href={`/en/posts/${post.id.replace(/^en\//, '')}`}>
                    {post.data.title}
                  </a>
                </h3>

                <p class="text-sm sm:text-base text-[#57524A] leading-relaxed mb-6 font-sans">
                  {post.data.description}
                </p>

                <div class="flex items-center justify-between pt-4 border-t border-[#E6E0D6]">
                  <div class="flex flex-wrap gap-2">
                    {post.data.tags.map((tag: string) => (
                      <span class="text-xs font-mono text-[#8A847A] bg-[#EFEBE4] px-2 py-0.5 rounded">
                        #{tag}
                      </span>
                    ))}
                  </div>

                  <div class="flex items-center gap-4">
                    <button
                      type="button"
                      class="copy-card-link-btn text-xs font-mono text-[#57524A] hover:text-[#E05A2B] flex items-center gap-1 cursor-pointer transition-colors"
                      data-url={`https://0500005.xyz/en/posts/${post.id.replace(/^en\//, '')}`}
                      title="Copy direct link"
                    >
                      <span>🔗 Share</span>
                    </button>

                    <a 
                      href={`/en/posts/${post.id.replace(/^en\//, '')}`}
                      class="text-xs sm:text-sm font-bold text-[#181715] hover:text-[#E05A2B] flex items-center gap-1 group/link"
                    >
                      <span>Read Full Report</span>
                      <span class="group-hover/link:translate-x-1 transition-transform">→</span>
                    </a>
                  </div>
                </div>
              </div>

              {post.data.cover && (
                <a 
                  href={`/en/posts/${post.id.replace(/^en\//, '')}`}
                  class="w-full md:w-48 h-40 rounded-xl overflow-hidden border-2 border-[#181715] shadow-[0_3px_0_#181715] shrink-0 bg-[#EFEBE4] order-first md:order-last block group/img"
                  aria-label={post.data.title}
                >
                  <img 
                    src={post.data.cover} 
                    alt={post.data.title} 
                    class="w-full h-full object-cover group-hover/img:scale-108 transition-transform duration-500" 
                    loading="lazy" 
                    decoding="async" 
                  />
                </a>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Newsletter Signup Component -->
  <Newsletter lang="en" />

  <script>
    function setupCardCopyEn() {
      document.querySelectorAll('.copy-card-link-btn').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();
          const url = btn.getAttribute('data-url');
          if (!url) return;
          try {
            await navigator.clipboard.writeText(url);
            const span = btn.querySelector('span');
            if (span) {
              const original = span.textContent;
              span.textContent = '✓ Copied!';
              setTimeout(() => { span.textContent = original; }, 2000);
            }
          } catch (err) {}
        });
      });
    }

    setupCardCopyEn();
    document.addEventListener('astro:page-load', setupCardCopyEn);
  </script>
</BaseLayout>
