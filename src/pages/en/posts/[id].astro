---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Newsletter from '../../../components/Newsletter.astro';
import SocialShare from '../../../components/SocialShare.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => data.lang === 'en');
  const sorted = posts.sort((a, b) => {
    const diff = b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
    if (diff !== 0) return diff;
    return (b.data.issue || '').localeCompare(a.data.issue || '');
  });

  return sorted.map((post, index) => ({
    params: { id: post.id.replace(/^en\//, '') },
    props: {
      post,
      prevPost: index < sorted.length - 1 ? sorted[index + 1] : null,
      nextPost: index > 0 ? sorted[index - 1] : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);

const cleanId = post.id.replace(/^en\//, '');
const alternateUrl = `/posts/${cleanId}`;
const currentUrl = new URL(Astro.url.pathname, Astro.site).toString();

// Calculate approximate reading time
const rawText = post.body || '';
const words = rawText.split(/\s+/).length;
const readingTimeMin = Math.max(2, Math.ceil(words / 180));

// Filter H2 and H3 for Table of Contents
const articleHeadings = headings ? headings.filter(h => h.depth === 2 || h.depth === 3) : [];
---

<BaseLayout
  title={`${post.data.title} | Everyday AI Lab`}
  description={post.data.description}
  lang="en"
  image={post.data.cover || '/images/hero-banner.webp'}
  alternateUrl={alternateUrl}
  pubDate={post.data.pubDate}
  author={post.data.author}
  type="article"
  categoryName={post.data.categoryName || post.data.category}
  categorySlug={post.data.category}
  tags={post.data.tags}
>
  <article class="max-w-3xl mx-auto py-6">
    <!-- Breadcrumb Navigation -->
    <div class="flex items-center gap-2 text-xs font-mono text-[#57524A] mb-6">
      <a href="/en" class="hover:underline hover:text-[#E05A2B]">Home</a>
      <span>/</span>
      <a href={`/en/category/${post.data.category}`} class="hover:underline text-[#E05A2B] font-bold">
        {post.data.categoryName || post.data.category}
      </a>
      <span>/</span>
      <span class="text-[#8A847A]">{post.data.issue || 'Dispatch'}</span>
    </div>

    <!-- Article Header -->
    <header class="mb-10 pb-8 border-b-2 border-[#181715]">
      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        {post.data.issue && (
          <span class="bg-[#E05A2B] text-[#FAF7F2] text-xs font-mono font-bold px-3 py-1 rounded-full shadow-2xs">
            {post.data.issue}
          </span>
        )}
        <span class="text-xs font-mono text-[#57524A]">
          {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </span>
        <span class="text-xs text-[#8A847A]">·</span>
        <span class="text-xs font-mono text-[#1E5E3A] font-bold">
          {post.data.author}
        </span>
        <span class="text-xs text-[#8A847A]">·</span>
        <span class="text-xs font-mono text-[#57524A] bg-[#EFEBE4] px-2 py-0.5 rounded border border-[#D9D2C5]">
          ⏱️ {readingTimeMin} min read
        </span>
      </div>

      <h1 class="font-serif text-2xl sm:text-4xl font-extrabold text-[#181715] tracking-tight leading-tight mb-4">
        {post.data.title}
      </h1>

      <p class="font-sans text-base sm:text-lg text-[#57524A] leading-relaxed">
        {post.data.description}
      </p>

      <!-- Language Switch Banner -->
      <div class="mt-6 p-4 bg-[#FAF7F2] border-2 border-[#181715] rounded-xl flex items-center justify-between text-xs font-mono shadow-[0_2px_0_#181715]">
        <span class="text-[#57524A]">🌐 阅读中文原版 (Chinese Edition)：</span>
        <a href={alternateUrl} class="text-[#E05A2B] font-bold hover:underline">
          阅读中文版 →
        </a>
      </div>

      <!-- Top Compact Share Bar -->
      <SocialShare title={post.data.title} url={currentUrl} lang="en" variant="compact" />

      <!-- Interactive Table of Contents (if 3+ headings exist) -->
      {articleHeadings.length >= 3 && (
        <details class="my-6 bg-[#FAF7F2] border-2 border-[#181715] rounded-2xl p-4 sm:p-5 shadow-[0_4px_0_#181715] group">
          <summary class="font-bold text-sm cursor-pointer flex items-center justify-between font-mono text-[#181715] select-none list-none">
            <span class="flex items-center gap-2">
              <span>📑</span>
              <span>Table of Contents</span>
            </span>
            <span class="text-xs text-[#8A847A] font-mono group-open:rotate-180 transition-transform">
              ▼
            </span>
          </summary>
          <nav class="mt-4 pt-3 border-t border-[#E6E0D6] space-y-2 text-xs font-mono">
            {articleHeadings.map((h) => (
              <div class={h.depth === 3 ? 'pl-4' : ''}>
                <a 
                  href={`#${h.slug}`} 
                  class="text-[#57524A] hover:text-[#E05A2B] hover:underline flex items-baseline gap-1.5 transition-colors py-0.5"
                >
                  <span class="text-[#E05A2B] text-[10px]">{h.depth === 2 ? '●' : '○'}</span>
                  <span>{h.text}</span>
                </a>
              </div>
            ))}
          </nav>
        </details>
      )}
    </header>

    <!-- Post Body Content -->
    <div class="prose-content">
      <Content />
    </div>

    <!-- Social Share Component -->
    <SocialShare title={post.data.title} url={currentUrl} lang="en" />

    <!-- Post Footer Tags & Return -->
    <footer class="mt-10 pt-6 border-t-2 border-[#E6E0D6]">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag: string) => (
            <span class="text-xs font-mono text-[#57524A] bg-[#EFEBE4] px-3 py-1 rounded-full border border-[#D9D2C5]">
              #{tag}
            </span>
          ))}
        </div>

        <a 
          href="/en" 
          class="text-xs font-bold font-mono text-[#181715] hover:text-[#E05A2B] transition-colors"
        >
          ← Return to All Dispatches
        </a>
      </div>

      <!-- Previous / Next Navigation Links -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-[#E6E0D6]">
        {prevPost ? (
          <a
            href={`/en/posts/${prevPost.id.replace(/^en\//, '')}`}
            class="card-3d interactive-tilt group p-4 rounded-xl border-2 border-[#181715] bg-[#FAF7F2] shadow-[0_3px_0_#181715] hover:border-[#E05A2B] transition-all"
          >
            <span class="text-[11px] font-mono text-[#8A847A] block mb-1">
              ← Previous Dispatch ({prevPost.data.issue || 'Previous'})
            </span>
            <span class="font-serif text-sm font-bold text-[#181715] group-hover:text-[#E05A2B] line-clamp-1 transition-colors">
              {prevPost.data.title}
            </span>
          </a>
        ) : (
          <div class="p-4 rounded-xl border-2 border-dashed border-[#D9D2C5] opacity-60 text-xs font-mono text-[#8A847A]">
            First Inaugural Issue
          </div>
        )}

        {nextPost ? (
          <a
            href={`/en/posts/${nextPost.id.replace(/^en\//, '')}`}
            class="card-3d interactive-tilt group p-4 rounded-xl border-2 border-[#181715] bg-[#FAF7F2] shadow-[0_3px_0_#181715] hover:border-[#E05A2B] transition-all text-right"
          >
            <span class="text-[11px] font-mono text-[#8A847A] block mb-1">
              Next Dispatch ({nextPost.data.issue || 'Next'}) →
            </span>
            <span class="font-serif text-sm font-bold text-[#181715] group-hover:text-[#E05A2B] line-clamp-1 transition-colors">
              {nextPost.data.title}
            </span>
          </a>
        ) : (
          <div class="p-4 rounded-xl border-2 border-dashed border-[#D9D2C5] opacity-60 text-xs font-mono text-[#8A847A] text-right">
            Latest Dispatch
          </div>
        )}
      </div>
    </footer>

    <!-- Newsletter CTA inside Article -->
    <Newsletter lang="en" />
  </article>

  <script>
    function setupCodeBlockCopyEn() {
      document.querySelectorAll('.prose-content pre').forEach((pre) => {
        if (pre.querySelector('.code-copy-btn')) return;
        pre.classList.add('relative', 'group');

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'code-copy-btn absolute top-3 right-3 bg-[#242321] hover:bg-[#383734] text-[#FAF7F2] text-xs font-mono px-2.5 py-1 rounded-lg border border-[#444] transition-colors cursor-pointer opacity-90 hover:opacity-100 shadow-2xs';
        button.innerHTML = '<span>📋 Copy</span>';

        button.addEventListener('click', async () => {
          const codeEl = pre.querySelector('code');
          const text = codeEl ? codeEl.innerText : (pre as HTMLElement).innerText;
          try {
            await navigator.clipboard.writeText(text);
            button.innerHTML = '<span class="text-[#10B981]">✓ Copied</span>';
            setTimeout(() => {
              button.innerHTML = '<span>📋 Copy</span>';
            }, 2000);
          } catch (e) {
            button.innerHTML = '<span class="text-[#10B981]">✓ Copied</span>';
            setTimeout(() => {
              button.innerHTML = '<span>📋 Copy</span>';
            }, 2000);
          }
        });

        pre.appendChild(button);
      });
    }

    setupCodeBlockCopyEn();
    document.addEventListener('astro:page-load', setupCodeBlockCopyEn);
  </script>
</BaseLayout>
